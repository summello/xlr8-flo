# PostgreSQL 17
POSTGRES_USER=flo
POSTGRES_PASSWORD=flo-local
POSTGRES_DB=flo_dev
DATABASE_URL=postgresql://flo:flo-local@localhost:5432/flo_dev
TEST_DATABASE_URL=postgresql://flo:flo-local@localhost:5432/flo_test

# Generate locally: python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
MFA_ENCRYPTION_KEY=replace-with-a-url-safe-base64-encoded-32-byte-key

# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=flo
MINIO_ROOT_PASSWORD=flo-local-secret
MINIO_BUCKET=flo-attachments
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=flo
S3_SECRET_ACCESS_KEY=flo-local-secret
S3_BUCKET=flo-attachments
S3_REGION=us-east-1
STORAGE_PROVIDER=minio

# Mailpit
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@xlr8flo.local
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_URL=http://localhost:8025
