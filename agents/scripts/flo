def _pill(stt):
    cls, label = {"todo": ("todo", "Todo"), "design": ("dsg", "Awaiting design"),
                  "in_progress": ("prog", "In progress"), "review": ("rev", "In review"),
                  "blocked": ("blk", "Blocked"), "done": ("done", "Done")}.get(stt, ("todo", stt))
    return f'<span class="pill {cls}"><i></i>{label}</span>'


def _esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def _burnup(rm, recaps):
    """Per-milestone completed vs in flight vs outstanding, with the counts as text."""
    rows = []
    for m in rm["milestones"]:
        ss = [s for e in rm["epics"] if e["milestone"] == m["id"] for s in e["stories"]]
        done = sum(1 for s in ss if s["st"] == "done")
        live = sum(1 for s in ss if s["st"] in ACTIVE)
        rows.append((m, len(ss), done, live, len(ss) - done - live))
    top = max((r[1] for r in rows), default=0) or 1
    total = sum(r[1] for r in rows)
    done_all = sum(r[2] for r in rows)
    live_all = sum(r[3] for r in rows)
    out = []
    for m, n, d, l, o in rows:
        def seg(v, color):
            return (f'<i style="width:{v / top * 100:.2f}%;background:var({color})"></i>'
                    if v else "")
        out.append(
            f'<tr><th scope="row">{_esc(m["id"])} <span class="gn">{_esc(m["name"])}</span></th>'
            f'<td class="bar" aria-hidden="true">{seg(d, "--ok")}{seg(l, "--info")}'
            f'{seg(o, "--sunken")}</td>'
            f'<td class="r">{d} done</td><td class="r">{l} in flight</td>'
            f'<td class="r">{o} outstanding</td><td class="r">{n} total</td></tr>')
    return (f'<p class="hint" style="padding:0 0 10px">{done_all} of {total} stories merged or deployed, '
            f'{live_all} in flight, {total - done_all - live_all} outstanding. '
            f'Bar length is scaled to the largest milestone.</p>'
            f'<table class="burn"><caption class="sr">Stories completed, in flight and '
            f'outstanding, by milestone</caption><tbody>{"".join(out)}</tbody></table>'
            f'<p class="hint legend" style="padding:10px 0 0">'
            f'<span><i style="background:var(--ok)"></i>Done</span> '
            f'<span><i style="background:var(--info)"></i>In flight</span> '
            f'<span><i style="background:var(--sunken);outline:1px solid var(--border)"></i>'
            f'Outstanding</span></p>')


def pending_on_human(rm, fleet, doc=None):
    """Only the things a person must resolve. Not agent work.

    Each item carries a stable `key` and a `sig`. Acknowledging an item stores its
    signature; if the underlying fact changes the ack goes stale and the item
    returns. Acknowledging is not resolving, and the board says so.
    """
    items = []
    for epic, s in stories(rm):
        if s["st"] == "blocked":
            q = None
            wt = worktree_path(s["id"]) / "task.json"
            if wt.exists():
                q = (json.loads(wt.read_text()).get("notes") or {}).get("blocked")
            items.append(dict(key=f"blocked:{s['id']}", sig=s["st"],
                              kind="Decision needed", ref=s["id"], name=s["t"],
                              why=q or "Story is blocked; the question is in its task packet."))
        # operator prerequisites: things only a person with an account can provide
        pre = s.get("prereq") or []
        if pre and s["st"] != "done":
            items.append(dict(key=f"prereq:{s['id']}", sig=str(len(pre)),
                              kind="Operator prerequisite", ref=s["id"], name=s["t"],
                              why="Cannot be verified end to end until you provide: "
                                  + "; ".join(pre)))
    # a milestone fully done but not yet merged to main
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ss = [s for e in eps for s in e["stories"]]
        got = ((doc or {}).get("milestones") or {}).get(m["id"]) or {}
        if ss and all(s["st"] == "done" for s in ss) and got.get("state") != "deployed":
            pr = got.get("pr") or {}
            if pr.get("state") == "OPEN":
                kind, why = "Merge the milestone PR", (
                    f"Every story in {m['id']} is merged into {m['branch']}; PR #{pr['number']} "
                    f"is {'a draft' if pr.get('isDraft') else 'open'}, CI {got.get('ci') or 'unknown'}. "
                    f"The Release steps tab lists what to do before merging.")
            else:
                kind, why = "Open the milestone PR", (
                    f"Every story in {m['id']} is merged into {m['branch']}. "
                    f"It needs a pull request to main.")
            items.append(dict(key=f"pr:{m['id']}", sig=f"{len(ss)}:{pr.get('number', '')}",
                              kind=kind, ref=m["id"], name=m["name"], why=why))
    # design packets missing for the milestone in progress
    cur = next((m for m in rm["milestones"]
                if any(s["st"] != "done" for e in rm["epics"] if e["milestone"] == m["id"]
                       for s in e["stories"])), None)
    if cur:
        eps = [e for e in rm["epics"] if e["milestone"] == cur["id"]]
        missing = [s["id"] for e in eps for s in e["stories"]
                   if s["st"] == "todo" and ((doc or {}).get("stories") or {}).get(
                       s["id"], {}).get("state", "todo") == "todo"
                   and not (ROOT / "design" / f"{s['id']}.md").exists()]
        if missing:
            items.append(dict(key=f"design:{cur['id']}", sig=str(len(missing)),
                              kind="Run the design pass", ref=cur["id"], name=cur["name"],
                              why=f"{len(missing)} stories have no design packet. "
                                  f"Opus must run `flo design {cur['id']}` before any can start."))
    # spend
    sp = state().get("spend", {})
    for name, cfg in fleet["agents"].items():
        cap = cfg.get("monthly_budget_usd")
        if cap and sp.get(name, 0) >= cap * 0.8:
            items.append(dict(key=f"budget:{name}", sig=f"{sp.get(name,0):.0f}",
                              kind="Budget nearly spent", ref=name, name=cfg["plan"],
                              why=f"${sp.get(name,0):.2f} of ${cap} used. Raise the cap in "
                                  f"agents.yaml or {name} drops out of the review rotation."))
    return items


def split_acked(items):
    """Partition into (open, confirmed). An ack whose signature moved is dropped."""
    acks = state().get("acks", {})
    open_, done = [], []
    for it in items:
        a = acks.get(it["key"])
        (done if a and a.get("sig") == it["sig"] else open_).append({**it, "ack": a})
    return open_, done


def cmd_ack(argv):
    """flo ack <KEY|all> — acknowledge a pending item. Acknowledging is not resolving."""
    if not argv:
        items = _pending(load_yaml(FLEET))
        if not items:
            print("nothing pending")
            return
        print("usage: flo ack <KEY>   (or `flo ack all`)\n")
        for it in items:
            print(f"  {it['key']:22} {it['kind']} · {it['ref']}")
        return
    rm, fleet = roadmap(), load_yaml(FLEET)
    items = {i["key"]: i for i in _pending(fleet)}
    keys = list(items) if argv[0] == "all" else [argv[0]]
    unknown = [k for k in keys if k not in items]
    if unknown:
        die(f"unknown pending key(s): {', '.join(unknown)} — run `flo ack` to list them")
    s = state()
    acks = s.setdefault("acks", {})
    stamp = git("log", "-1", "--format=%cI", check=False) or "unknown"
    for k in keys:
        acks[k] = {"sig": items[k]["sig"], "at": stamp}
        print(f"confirmed  {k}  ({items[k]['kind']} · {items[k]['ref']})")
    save_state(s)
    print("\nAcknowledged, not resolved — these return if the underlying fact changes.")
    cmd_board([])


def cmd_unack(argv):
    if not argv:
        die("usage: flo unack <KEY|all>")
    s = state()
    acks = s.setdefault("acks", {})
    for k in (list(acks) if argv[0] == "all" else [argv[0]]):
        acks.pop(k, None)
        print(f"reopened  {k}")
    save_state(s)
    cmd_board([])


def _bar(done, live, total, label, width=None):
    """Progress bar: done in one colour, in-flight in another, scaled to the total."""
    pct = lambda n: (n / total * 100) if total else 0
    style = f' style="width:{width}"' if width else ""
    return (f'<span class="track"{style} role="progressbar" aria-label="{_esc(label)}" '
            f'aria-valuemin="0" aria-valuemax="{total}" aria-valuenow="{done}" '
            f'aria-valuetext="{done} of {total} done, {live} in flight">'
            f'<span class="fill done" style="width:{pct(done):.2f}%"></span>'
            f'<span class="fill live" style="width:{pct(live):.2f}%"></span></span>')


def _view_roadmap(doc):
    """The legacy roadmap shape (milestones, epics, stories with `st`) built from delivery state."""
    legacy = {"deployed": "done", "merged": "done", "committed": "review",
              "in_progress": "in_progress", "ready": "todo", "todo": "todo"}
    epics = []
    for eid, e in doc["epics"].items():
        ss = []
        for sid, v in doc["stories"].items():
            if v["epic"] != eid:
                continue
            st = "blocked" if v.get("blocked") else legacy[v["state"]]
            ss.append({"id": sid, "t": v["title"], "k": v["kind"], "s": v["size"],
                       "tags": v["tags"], "dep": v["dep"], "reqs": [], "st": st})
        epics.append({"id": eid, "name": e["name"], "milestone": e["milestone"], "stories": ss})
    return {"milestones": [{"id": k, "name": v["name"], "branch": v["branch"]}
                           for k, v in doc["milestones"].items()], "epics": epics}


def _delivery(use_gh=True, fetch=False):
    import flo_delivery as D

    root = D.main_root(ROOT)
    doc = D.gather(root, use_gh=use_gh, fetch=fetch and D.fetch_due(root))
    if doc.get("error"):
        die(doc["error"])
    return root, doc


def _pending(fleet):
    _, doc = _delivery(use_gh=False)
    return pending_on_human(_view_roadmap(doc), fleet, doc)


_STATE_CLASS = {"todo": "todo", "ready": "ready", "in_progress": "inpr", "committed": "cmt",
                "merged": "mrg", "deployed": "dep"}
_GROUP_CLASS = {"todo": "todo", "on_train": "train", "ready_to_merge": "rtm", "deployed": "dep"}


def _state_pill(state, blocked=False):
    import flo_delivery as D

    if blocked:
        return '<span class="pill blk"><i></i>Blocked</span>'
    return f'<span class="pill {_STATE_CLASS[state]}"><i></i>{D.STORY_LABEL[state]}</span>'


def _group_pill(state, note=None):
    import flo_delivery as D

    extra = f'<span class="note">{_esc(note)}</span>' if note else ""
    return f'<span class="pill {_GROUP_CLASS[state]}"><i></i>{D.GROUP_LABEL[state]}</span>{extra}'


def _board_once(fetch=True, use_gh=True):
    global BOARD, _SCORES_OVERRIDE
    import flo_delivery as D
    import flo_release as R

    root, doc = _delivery(use_gh=use_gh, fetch=fetch)
    D.write_status(root, doc)
    BOARD = root / "board.html"
    best = D.best_json(root, "agents/scorecard.json", "stories")
    if best is not None:
        _SCORES_OVERRIDE = best
    rm, fleet = _view_roadmap(doc), load_yaml(FLEET)
    sc = {s["story"]: s for s in load_scores()["stories"]}
    all_s = [s for _, s in stories(rm)]
    ready = [(e, s) for e, s in stories(rm) if s["st"] == "todo" and deps_satisfied(rm, s)]
    pending, confirmed = split_acked(pending_on_human(rm, fleet, doc))
    cnt = doc["counts"]

    # Named first: adjacent string literals inside a list literal read as a missing comma.
    legend = (
        '<p class="hint" style="padding:10px 0 0"><span id="age" class="fresh"></span> '
        '&middot; Deployed = on main with a green deploy run. Merged = in its milestone '
        'branch (or on main, deploy not green yet). Committed = reviewed, waiting for '
        '<span class="mono">flo done</span>.</p>'
    )
    tabs_nav = (
        '<nav class="tabs" role="tablist" aria-label="Board views">'
        '<button role="tab" data-tab="delivery" aria-selected="true">Delivery</button>'
        '<button role="tab" data-tab="release" aria-selected="false">Release steps</button>'
        '</nav>'
    )
    parts = ["<!doctype html>", '<html lang="en"><head><meta charset="utf-8">',
             '<meta name="viewport" content="width=device-width,initial-scale=1">',
             "<title>XLR8 FLO Board</title>", R.FAVICON,
             f"<style>{BOARD_CSS}{R.CSS}</style>",
             '<link rel="preconnect" href="https://fonts.googleapis.com">',
             # Explicit +, not implicit adjacency: CodeQL reads adjacent string
             # literals inside a list as a possible missing comma, and that warning
             # fails the code-scanning gate on every pull request.
             ('<link rel="stylesheet" href="https://fonts.googleapis.com/css2?'
              + 'family=Inter:wght@400;500;560;600;620;640'
              + '&family=JetBrains+Mono:wght@400;460;620&display=swap">'),
             f'</head><body data-generated="{doc["generated_at"]}">',
             '<div class="w">', "<header>",
             f'<div><p class="eb">Delivery board</p><h1>XLR8 FLO</h1></div><div class="sp"></div>',
             f'<div class="stat"><span class="eb">Deployed</span><b>{cnt["deployed"]}/{len(all_s)}</b></div>',
             f'<div class="stat"><span class="eb">Merged</span><b>{cnt["merged"]}</b></div>',
             f'<div class="stat"><span class="eb">Committed</span><b>{cnt["committed"]}</b></div>',
             f'<div class="stat"><span class="eb">In progress</span><b>{cnt["in_progress"]}</b></div>',
             f'<div class="stat"><span class="eb">Ready</span><b>{cnt["ready"]}</b></div>',
             f'<div class="stat"><span class="eb">To do</span><b>{cnt["todo"]}</b></div>',
             f'<div class="stat"><span class="eb">On you</span><b>{len(pending)}</b></div>',
             "</header>",
             legend,
             (f'<p class="hint" style="padding:6px 0 0"><span class="pill blk"><i></i>'
              f'Latest deploy on main failed</span> Stories on main stay Merged until a deploy '
              f'run succeeds. <span class="mono">gh run list --branch main --limit 3</span></p>'
              if (doc.get("main") or {}).get("deploy") == "failure" else
              '<p class="hint" style="padding:6px 0 0"><span class="pill dsg"><i></i>Deploy runs '
              'not readable</span> GitHub could not be reached, so Deployed means on main only.</p>'
              if doc.get("deploy_check") == "unavailable" else ""),
             tabs_nav,
             '<div class="tab" id="tab-delivery">']

    parts += ['<section><h2>Progress</h2><div class="card chart">', _burnup(rm, sc), "</div></section>"]

    # ── pending on the human ──
    parts.append('<section><h2>Waiting on you</h2><div class="card you">')
    if pending:
        for it in pending:
            parts.append(f'<div class="row"><div class="q"><b>{_esc(it["kind"])} · '
                         f'<span class="mono">{_esc(it["ref"])}</span> {_esc(it["name"])}</b>'
                         f'<span>{_esc(it["why"])}</span>'
                         f'<span class="mono" style="font-size:10.5px;opacity:.7">'
                         f'flo ack {_esc(it["key"])}</span></div></div>')
    else:
        parts.append('<div class="empty">Nothing open. The fleet is unblocked.</div>')
    parts.append("</div>")
    if confirmed:
        parts.append('<div class="card ok" style="margin-top:12px">')
        for it in confirmed:
            when = (it.get("ack") or {}).get("at", "")[:10]
            parts.append(f'<div class="row"><b>✓ {_esc(it["kind"])} · '
                         f'<span class="mono">{_esc(it["ref"])}</span></b>'
                         f'<span>{_esc(it["why"])}</span>'
                         f'<span class="when">confirmed {_esc(when)}</span></div>')
        parts.append('<p class="hint">Confirmed, not resolved — each returns automatically if its '
                     'underlying fact changes. Reopen with <span class="mono">flo unack &lt;key&gt;</span>.</p>')
        parts.append("</div>")
    parts.append("</section>")

    # ── next up ──
    parts.append('<section><h2>Next up</h2><div class="card next">')
    if ready:
        for e, s in ready[:6]:
            parts.append(f'<div class="row">{_pill(s["st"])}<span class="mono" style="font-size:11.5px;'
                         f'color:var(--fg3)">{s["id"]}</span><span>{_esc(s["t"])}</span>'
                         f'<span class="cmd">flo start {s["id"]}</span></div>')
    else:
        parts.append('<div class="empty">No story has its dependencies satisfied.</div>')
    parts.append("</div></section>")

    # ── agent scores ──
    scores, floor = compute_scores()
    parts.append('<section><h2>Agent performance</h2><div class="two">')

    def _grade(v):
        return "gn" if v is None else ("g80" if v >= 75 else "g60" if v >= 55 else "g0")

    def _cell(v):
        cls = _grade(v)
        if v is None:
            return '<span class="scv gn">—</span>'
        hue = "var(--ok)" if v >= 75 else "var(--info)" if v >= 55 else "var(--warn)"
        return (f'<span class="spark"><i style="width:{v:.0f}%;background:{hue}"></i></span>'
                f'<span class="scv {cls}">{v:.0f}</span>')

    auth = [(a, m) for a, m in scores.items() if m.get("authored")]
    rev = [(a, m) for a, m in scores.items() if m.get("reviewed")]

    parts.append('<div class="card"><table class="sc"><tr><th>As author</th>'
                 '<th class="r">Stories</th><th class="r">Clean</th><th class="r">Rounds</th>'
                 '<th class="r">Score</th></tr>')
    if auth:
        for a, m in sorted(auth, key=lambda kv: -(kv[1].get("author_score") or -1)):
            parts.append(f'<tr><td class="ag">{_esc(a)}</td><td class="r">{m["authored"]}</td>'
                         f'<td class="r">{m["clean_merge_rate"]:.0%}</td>'
                         f'<td class="r">{m["mean_rounds"]:.2f}</td>'
                         f'<td class="r">{_cell(m.get("author_score"))}</td></tr>')
    else:
        parts.append('<tr><td colspan="5" class="empty">No stories merged yet.</td></tr>')
    parts.append(f'</table><p class="hint">Score = 50 × clean-merge + 30 × round efficiency '
                 f'+ 20 × (1 − escape rate). Shown once an agent has {floor}+ stories.</p></div>')

    parts.append('<div class="card"><table class="sc"><tr><th>As reviewer</th>'
                 '<th class="r">Reviews</th><th class="r">Tests</th><th class="r">Missed</th>'
                 '<th class="r">Score</th></tr>')
    if rev:
        for a, m in sorted(rev, key=lambda kv: -(kv[1].get("reviewer_score") or -1)):
            parts.append(f'<tr><td class="ag">{_esc(a)}</td><td class="r">{m["reviewed"]}</td>'
                         f'<td class="r">{m["test_compliance"]:.0%}</td>'
                         f'<td class="r">{m["escapes_missed"]}</td>'
                         f'<td class="r">{_cell(m.get("reviewer_score"))}</td></tr>')
    else:
        parts.append('<tr><td colspan="5" class="empty">No reviews recorded yet.</td></tr>')
    parts.append(f'</table><p class="hint">Score = 25 × test compliance + 30 × blocker precision '
                 f'+ 30 × catch rate + 15 × thoroughness. <em>Missed</em> counts escapes on gated '
                 f'stories this agent approved.</p></div>')
    parts.append('</div><p class="hint" style="padding-left:0">These route work; they do not rank '
                 'agents. A low author score on one <span class="mono">kind</span> and a high one on '
                 'another is a signal to change <span class="mono">allowed_kinds</span> in '
                 '<span class="mono">agents/agents.yaml</span>.</p></section>')

    # ── drilldown ──
    parts.append("<section><h2>Milestones</h2>")
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ms_s = [s for e in eps for s in e["stories"]]
        d = sum(1 for s in ms_s if s["st"] == "done")
        lv = sum(1 for s in ms_s if s["st"] in ACTIVE)
        opn = "open" if any(s["st"] != "done" for s in ms_s) and d < len(ms_s) else ""
        parts.append(
            f'<details class="card ms" {opn}><summary>'
            f'<span class="caret">▸</span><span class="nm">{m["id"]} · {_esc(m["name"])}</span>'
            + _group_pill(doc["milestones"][m["id"]]["state"], doc["milestones"][m["id"]]["note"]) +
            f'<span class="sp"></span>' + _bar(d, lv, len(ms_s), f'{m["id"]} {m["name"]}') +
            f'<span class="cnt">{d}/{len(ms_s)}</span></summary>')
        for e in eps:
            ed = sum(1 for s in e["stories"] if s["st"] == "done")
            el = sum(1 for s in e["stories"] if s["st"] in ACTIVE)
            parts.append(
                f'<details class="epic"><summary><span class="caret">▸</span>'
                f'<span class="mono" style="font-size:11.5px;color:var(--fg3)">{e["id"]}</span>'
                f'<span>{_esc(e["name"])}</span>'
                + _group_pill(doc["epics"][e["id"]]["state"]) + f'<span class="sp"></span>'
                + _bar(ed, el, len(e["stories"]), f'{e["id"]} {e["name"]}', "88px") +
                f'<span class="cnt">{ed}/{len(e["stories"])}</span></summary><table>')
            for s in e["stories"]:
                rec = sc.get(s["id"], {})
                recap = rec.get("recap")
                sess = rec.get("sessions") or {}
                who = rec.get("author", "")
                meta = (f'{_esc(who)}<br>{rec["rounds"]} round'
                        f'{"s" if rec.get("rounds",1) != 1 else ""}') if rec else \
                       "".join(f'<span class="tag">{t}</span>' for t in s.get("tags", []))
                body = _esc(s["t"])
                if recap:
                    body += f'<span class="recap">{_esc(recap)}</span>'
                if sess:
                    ids = " · ".join(f'{a}:{v["id"][:8]}' for a, v in sorted(sess.items()) if v.get("id"))
                    if ids:
                        body += f'<span class="recap mono" style="font-size:10.5px;opacity:.75">{_esc(ids)}</span>'
                parts.append(f'<tr><td class="id">{s["id"]}</td><td class="st">'
                             f'{_state_pill(doc["stories"][s["id"]]["state"], s["st"] == "blocked")}</td>'
                             f'<td>{body}</td><td class="meta">{meta}</td></tr>')
            parts.append("</table></details>")
        parts.append("</details>")
    parts.append("</section>")

    parts.append("</div>")
    parts.append(f'<div class="tab" id="tab-release" hidden>{R.runbook_html(doc)}</div>')
    parts.append(f'<footer>Generated by <span class="mono">flo board</span> from '
                 f'git refs, worktrees and GitHub (<span class="mono">.flo/status.json</span>), and '
                 f'<span class="mono">agents/scorecard.json</span>. '
                 f'Gitignored — regenerate any time, never commit.</footer></div>'
                 f'<script>{R.SCRIPT}</script></body></html>')
    BOARD.write_text("\n".join(parts) + "\n")
    print(f"board.html regenerated — {cnt['deployed']}/{len(all_s)} deployed, {cnt['merged']} merged, "
          f"{cnt['committed']} committed, {cnt['in_progress']} in progress, {cnt['ready']} ready, "
          f"{len(pending)} waiting on you"
          + (f", {len(confirmed)} confirmed" if confirmed else ""))


def cmd_board(argv):
    """flo board [--watch [SECONDS]] [--no-gh] [--no-fetch]

    Refreshes .flo/status.json and board.html in the primary checkout from git refs, worktrees
    and GitHub. Safe to run from any checkout, any time; Mission Control's handler runs it every
    minute, and --watch does the same from a plain terminal.
    """
    use_gh, fetch = "--no-gh" not in argv, "--no-fetch" not in argv
    if "--watch" not in argv:
        return _board_once(fetch=fetch, use_gh=use_gh)
    i = argv.index("--watch")
    every = int(argv[i + 1]) if len(argv) > i + 1 and argv[i + 1].isdigit() else 60
    while True:
        try:
            _board_once(fetch=fetch, use_gh=use_gh)
        except SystemExit:
            # a refresh that dies (die() on an unreadable repo) must not end the watch loop;
            # the next tick retries
            pass
        time.sleep(every)


# ── shells ───────────────────────────────────────────────────────────────────

CHECKS = [
    # Cheapest first: run_check stops at the first red, so a lint slip never costs a pytest run.
    ("ruff", ["ruff", "check", "apps/api"]),
    ("mypy", ["mypy", "--strict", "apps/api/src/flo"]),
    ("boundaries", ["lint-imports"]),
    ("eslint", ["npm", "--prefix", "apps/web", "run", "lint"]),
    ("tsc", ["npm", "--prefix", "apps/web", "run", "typecheck"]),
    ("vitest", ["npm", "--prefix", "apps/web", "run", "test"]),
    ("secrets", ["gitleaks", "detect", "--no-banner"]),
    # Same flags CI runs. Without them a green `flo check` can still fail CI on a
    # missing pytest-cov, which is exactly how E01-S01 reached a red pull request.
    ("pytest", ["pytest", "-q", "apps/api", "--cov=flo", "--cov-report=term-missing"]),
    ("e2e+axe", ["npm", "--prefix", "apps/web", "run", "test:e2e"]),
]
# The story gate (13 Oct 2026): everything but the two full suites, which hosted CI runs on the
# story branch instead, plus the tests the story itself touched (story_checks).
HEAVY = {"pytest", "e2e+axe"}

# Every current M0 check is delivered and therefore mandatory. Temporary exemptions must
# name both their reason and the story that removes them; docs/ops/ci-gates.md mirrors this.
M0_MISSING_TOOL_OPTOUTS = {}
LOCAL_POSTGRES = "postgresql://flo:flo-local@127.0.0.1:5432/"


def test_database_url(cwd):
    """One database per worktree, so parallel stories never share, or reset, each other's data."""
    digest = hashlib.sha256(str(Path(cwd).resolve()).encode()).hexdigest()[:8]
    return f"{LOCAL_POSTGRES}flo_test_{digest}"


def fresh_test_database(cwd):
    import psycopg  # lives in the worktree venv; run flo with that interpreter

    url = test_database_url(cwd)
    name = url.rsplit("/", 1)[1]
    with psycopg.connect(LOCAL_POSTGRES + "postgres", autocommit=True) as connection:
        connection.execute(f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)')
        connection.execute(f'CREATE DATABASE "{name}"')
    return url


def cmd_db(argv):
    action = argv[0] if argv else "url"
    if action not in ("url", "reset"):
        die("usage: flo db [url|reset]")
    print(fresh_test_database(Path.cwd()) if action == "reset" else test_database_url(Path.cwd()))


def story_checks(cwd):
    """The story's own tests: the ones its diff adds or edits, against the milestone it merged."""
    task = Path(cwd) / "task.json"
    if not task.exists():
        return []
    base = git("merge-base", "HEAD", json.loads(task.read_text())["milestone_branch"],
               cwd=cwd, check=False)
    if not base:
        return []
    changed = [f for f in git("diff", "--name-only", "--diff-filter=d", base, "HEAD",
                              cwd=cwd).splitlines()]
    py = [f for f in changed if f.startswith("apps/api/tests/") and Path(f).name.startswith("test_")
          and f.endswith(".py")]
    # Migrations live at the repo root; the static tenancy gates and the grant baseline read
    # them, and story CI caught what the light gate missed twice on M3 (0056, 0060).
    if any(f.startswith(("migrations/", "apps/api/migrations/")) for f in changed):
        py += ["apps/api/tests/kernel/test_migrate.py",
               "apps/api/tests/isolation/test_ci_guards.py",
               "apps/api/tests/gates/test_gates_bite.py",
               "apps/api/tests/authz/test_baseline_grants.py"]
    # A module's own suite runs when its source changes and the story touched none of its tests:
    # E11-S07 added a master kind without touching tests/org, and only full CI found
    # test_master's per-kind table missing it. A story that edits the module's tests runs those.
    for m in {f.split("/")[5] for f in changed if f.startswith("apps/api/src/flo/modules/")
              and f.count("/") > 5}:
        if (Path(cwd) / "apps/api/tests" / m).is_dir() and not any(
                f.startswith(f"apps/api/tests/{m}/") for f in py):
            py.append(f"apps/api/tests/{m}")
    web = [f.removeprefix("apps/web/") for f in changed
           if re.match(r"apps/web/(e2e/.+\.e2e\.ts|tests/(a11y|e2e)/.+\.spec\.ts)$", f)]
    out = []
    if py:
        out.append(("story pytest", ["pytest", "-q", *sorted(set(py))]))
    if web:
        out.append(("story e2e", ["npm", "--prefix", "apps/web", "run", "test:e2e", "--", *web]))
    return out


# The steps the last run_check ran, as {name, ok}. A module list rather than a parameter so
# run_check keeps its two-argument signature: tests/gates/test_gates_bite.py stubs it that way.
LAST_STEPS = []


def run_check(cwd=None, profile="full"):
    cwd = cwd or ROOT
    venv_bin = Path(cwd) / "apps" / "api" / ".venv" / "bin"
    steps = CHECKS if profile == "full" else (
        [c for c in CHECKS if c[0] not in HEAVY] + story_checks(cwd))
    for name, cmd in steps:
        command_environment = os.environ.copy()
        if venv_bin.is_dir():
            # lint-imports and friends live in the story venv; the codex sandbox has no other PATH
            command_environment["PATH"] = f"{venv_bin}{os.pathsep}{command_environment['PATH']}"
        if "pytest" in name and "DATABASE_URL" not in command_environment:
            url = fresh_test_database(cwd)
            command_environment["DATABASE_URL"] = url
            command_environment["TEST_DATABASE_URL"] = url
        try:
            r = subprocess.run(
                cmd,
                cwd=cwd,
                capture_output=True,
                text=True,
                env=command_environment,
            )
        except FileNotFoundError:
            r = subprocess.CompletedProcess(cmd, 127, "", f"required tool not found: {cmd[0]}")
        if r.returncode == 127:
            exemption = M0_MISSING_TOOL_OPTOUTS.get(name)
            if exemption is not None:
                print(f"  ?  {name:<12} missing-tool opt-out: {exemption}")
                continue
        print(f"  {'✓' if not r.returncode else '✗'}  {name}")
        LAST_STEPS.append({"name": name, "ok": not r.returncode})
        if r.returncode:
            print((r.stdout + r.stderr).strip()[-2000:])
            return False
    return True


def record_evidence(task, rec):
    """Append one evidence record to task.json. Only flo writes these: the gate checks a reviewer's
    claim against them, so a verdict cannot vouch for itself. ponytail: the threat is a wrong or
    stale claim, not an agent editing runner state; sign the records if that ever changes."""
    pkt = json.loads(task.read_text())
    pkt["evidence"] = (pkt.get("evidence") or []) + [rec]
    pkt["evidence"] = pkt["evidence"][-50:]
    task.write_text(json.dumps(pkt, indent=2) + "\n")


def evidence_for(pkt, commit, profile):
    """A passing, clean record for this commit; a full run also vouches for a light claim."""
    return next((r for r in pkt.get("evidence") or []
                 if r.get("commit") == commit and r.get("result") == "pass" and r.get("clean") is True
                 and r.get("profile") in (profile, "full")), None)


def checked(wt, profile):
    """run_check once per tree: submit records a green tree, and the gate on an identical,
    clean tree reuses it instead of running the same deterministic checks again. Every run, and
    every cache hit on a commit with no record yet, leaves an evidence record in task.json."""
    tree = git("rev-parse", "HEAD^{tree}", cwd=wt)
    commit = git("rev-parse", "HEAD", cwd=wt)
    clean = not git("status", "--porcelain", cwd=wt)
    task = Path(wt) / "task.json"
    pkt = json.loads(task.read_text()) if task.exists() else {}
    if clean and pkt.get("check") == {"tree": tree, "profile": profile}:
        print(f"  ✓  check --{profile} (cached: tree {tree[:10]} unchanged since it went green)")
        if not evidence_for(pkt, commit, profile):  # same tree, new commit: the result carries over
            record_evidence(task, {"profile": profile, "commit": commit, "tree": tree, "clean": True,
                                   "result": "pass", "cached": True, "steps": [], "seconds": 0,
                                   "at": now_iso()})
        return True
    LAST_STEPS.clear()
    began = time.time()
    ok = run_check(wt, profile)
    report = list(LAST_STEPS)
    if task.exists():
        record_evidence(task, {"profile": profile, "commit": commit, "tree": tree, "clean": clean,
                               "result": "pass" if ok else "fail", "steps": report,
                               "seconds": round(time.time() - began), "at": now_iso()})
    if not ok:
        return False
    if clean and task.exists():
        pkt = json.loads(task.read_text())
        pkt["check"] = {"tree": tree, "profile": profile}
        task.write_text(json.dumps(pkt, indent=2) + "\n")
    return True


def story_ci_failure(pkt, wt):
    """None when GitHub's CI is green on the submitted commit and the story has not changed
    since; otherwise the reason. Merges of the milestone branch are not story changes."""
    sha = pkt.get("submitted_sha")
    if not sha:
        return "no submitted_sha in task.json — run flo submit (it pushes the story branch)"
    if git("log", "--first-parent", "--no-merges", "--format=%h", f"{sha}..HEAD", cwd=wt):
        return f"story commits after {sha[:10]} were never CI'd — run flo submit again"
    runs = gh_runs(pkt["branch"])
    run = next((r for r in runs if r.get("headSha") == sha), None)
    if run is None:
        return f"no CI run for {sha[:10]} on {pkt['branch']} yet"
    if run.get("status") != "completed":
        return f"story CI still {run.get('status')} on {sha[:10]}"
    if run.get("conclusion") != "success":
        return f"story CI {run.get('conclusion')} on {sha[:10]}: gh run view {run.get('databaseId')} --log-failed"
    return None


def _alive(pidfile):
    try:
        os.kill(int(pidfile.read_text().split()[0]), 0)
        return True
    except (OSError, ValueError):
        return False


def _read(path):
    try:
        return path.read_text()
    except OSError:
        return None


def _ci_on(branch, sha):
    """green | red | pending | none: the story CI run on the submitted commit."""
    run = next((r for r in gh_runs(branch) if r.get("headSha") == sha), None) if sha else None
    if not run:
        return "none"
    if run.get("status") != "completed":
        return "pending"
    return "green" if run.get("conclusion") == "success" else "red"


def _reviewers(pkt):
    rev = list(pkt.get("reviewers") or [])
    return rev + (["opus"] if pkt.get("opus_final") and "opus" not in rev else [])


def _carry(sc, wt, pkt, sid, reviewer, reviewed, sub):
    """E23-S16: move a usable verdict's baseline from `reviewed` to `sub` when the story's own commits
    between them touch nothing but the generated API client (a milestone merge adds none). Returns
    `sub` once carried, else None. The verdict file, its run record and review_runs are untouched:
    a carry is evidence, not a review."""
    r = subprocess.run(["git", "log", "--no-merges", "--name-only", "--format=", f"{reviewed}..{sub}",
                        "--not", f"origin/{pkt['milestone_branch']}"], cwd=wt, capture_output=True, text=True)
    if r.returncode:
        return None
    import flo_facts as F
    paths = sorted({p for p in r.stdout.split("\n") if p})
    if not F.carryable(paths):
        return None
    at = datetime.now().astimezone().isoformat(timespec="seconds")
    entry = {"reviewer": reviewer, "carried_from": reviewed, "carried_to": sub, "paths": paths, "at": at}
    (sc / f"{sid}.{reviewer}.carried.json").write_text(json.dumps(entry, indent=2) + "\n")
    pkt.setdefault("carried_reviews", []).append(entry)
    (wt / "task.json").write_text(json.dumps(pkt, indent=2) + "\n")
    (sc / f"{sid}.{reviewer}.launched").write_text(sub + "\n")
    return sub


def cmd_facts(argv):
    """flo facts: the delivery state as JSON, for the fleet supervisor (~/.claude/fleet/fleet.py).

    Facts only; the supervisor decides. Per in-flight story: who authors it and on which account,
    which processes run (pidfiles author.sh and review.sh write), how the author's last run ended,
    whether the head is submitted, each reviewer's verdict on the submitted commit, rounds so far,
    and red CI. Plus what may start next and which red milestone, if any, stopped the line."""
    import flo_facts as F
    rm, fleet = roadmap(), load_yaml(FLEET)
    pol, sc = fleet["policy"], ROOT / ".scratch"
    names = [p.name for p in sc.iterdir()] if sc.exists() else []
    out = []
    for _, s in stories(rm):
        sid, wt = s["id"], worktree_path(s["id"])
        red = (sc / f"{sid}.ci-red").exists()
        if not (s["st"] in ACTIVE or (s["st"] == "done" and red)) or not (wt / "task.json").exists():
            continue
        pkt = json.loads((wt / "task.json").read_text())
        author, sub = pkt["author"], pkt.get("submitted_sha")
        red = F.ci_red(_read(sc / f"{sid}.ci-red"), sub)
        running = ["author"] if _alive(sc / f"{sid}.author.pid") else []
        verdicts = {}
        for r in _reviewers(pkt):
            if _alive(sc / f"{sid}.{r}.pid"):
                running.append(f"review:{r}")
            raw = _read(wt / "reviews" / f"{sid}.{r}.json")
            try:
                review = json.loads(raw) if raw else None
            except json.JSONDecodeError:
                review = {"verdict": "malformed"}
            # .launched is written at each launch; older runs left .sha (codex) or .sha.new (opus)
            seen = next((t.strip() for t in (_read(sc / f"{sid}.{r}.{x}") for x in ("launched", "sha", "sha.new")) if t), None)
            if review and seen and sub and seen != sub and F.verdict_state(review, seen, seen) in ("approve", "changes"):
                seen = _carry(sc, wt, pkt, sid, r, seen, sub) or seen
            tries = (_read(sc / f"{sid}.{r}.attempts") or "").split()
            verdicts[r] = F.verdict_state(
                review, seen, sub, attempts=tries.count(seen) if seen else 0,
                capped="stopped at the time cap" in (_read(sc / f"{sid}.{r}.log") or ""))
        approved = bool(verdicts) and all(v == "approve" for v in verdicts.values())
        out.append({
            "id": sid, "title": s["t"], "st": s["st"], "merged": s["st"] == "done",
            "author": author, "account": ((pkt.get("sessions") or {}).get(author) or {}).get("account"),
            "gated": bool(pkt.get("opus_final")),
            "blocked": s["st"] == "blocked" or bool((pkt.get("notes") or {}).get("blocked")),
            "rounds": F.rounds_done(names, sid), "running": running,
            "author_result": F.author_result(_read(sc / f"{sid}.log")),
            "head": git("rev-parse", "HEAD", cwd=wt, check=False), "submitted_sha": sub,
            "verdicts": verdicts, "ci_red": red,
            "ci_jobs": F.red_jobs(_read(sc / f"{sid}.ci-red")) if red else [],
            # asked of GitHub only where it decides something: a gated story waiting to finish
            "ci": _ci_on(pkt["branch"], sub) if approved and pkt.get("opus_final") else None,
        })
    sonnet = fleet["agents"].get("sonnet") or {}
    # a story flo start would refuse (no valid pre-flight record) is not offered as startable
    ready = [s["id"] for _, s in stories(rm) if s["st"] == "todo" and deps_satisfied(rm, s)
             and (ROOT / "design" / f"{s['id']}.md").exists()]
    print(json.dumps({
        "project": ROOT.name, "max_in_flight": pol["max_stories_in_flight"],
        "max_rounds": pol.get("max_review_rounds", 3),
        "in_flight": sum(1 for _, s in stories(rm) if s["st"] in ACTIVE),
        "line_stopped": [m["id"] for m in rm["milestones"] if (sc / f"{m['id']}.ci-red").exists()],
        "line_stopped_jobs": {m["id"]: {"sha": (_read(sc / f"{m['id']}.ci-red") or "").split("\n", 1)[0],
                                        "jobs": F.red_jobs(_read(sc / f"{m['id']}.ci-red"))}
                              for m in rm["milestones"] if (sc / f"{m['id']}.ci-red").exists()},
        "next": [i for i in ready if preflight_state(i)[0]][:5],
        "needs_preflight": [i for i in ready if not preflight_state(i)[0]],
        "free_accounts": free_accounts("sonnet", sonnet) if sonnet.get("accounts") else [],
        "stories": out,
    }, indent=1))


def cmd_round(argv):
    """flo round <S>: write the next round file from the reviewers' changes_requested verdicts and
    print its path, for agents/scripts/author.sh to resume the author with."""
    import flo_facts as F
    if not argv:
        die("usage: flo round <STORY_ID>")
    sid = argv[0]
    pkt, wt, sc = packet_of(sid), worktree_path(sid), ROOT / ".scratch"
    verdicts = {}
    for r in _reviewers(pkt):
        raw = _read(wt / "reviews" / f"{sid}.{r}.json")
        if raw:
            try:
                verdicts[r] = json.loads(raw)
            except json.JSONDecodeError:
                die(f"malformed review: reviews/{sid}.{r}.json")
    n = F.rounds_done([p.name for p in sc.iterdir()] if sc.exists() else [], sid) + 1
    path = sc / f"{sid}.round{n}.md"
    path.write_text(F.round_file(sid, n, verdicts))
    print(path)


def cmd_ci_watch(argv):
    """One monitoring pass (agents/scripts/ci-watch.sh loops it). A completed red run on a
    submitted story writes .scratch/<S>.ci-red with the failing log, for the planner to resume
    the author's session with; green clears the marker and reaps a merged story's worktree.
    Red on a milestone branch writes .scratch/<M>.ci-red: stop the line."""
    rm, scratch = roadmap(), ROOT / ".scratch"
    scratch.mkdir(exist_ok=True)

    def mark(key, branch, run):
        marker = scratch / f"{key}.ci-red"
        if marker.exists() and run["headSha"] in marker.read_text().split("\n", 1)[0]:
            return
        log = subprocess.run(["gh", "run", "view", str(run["databaseId"]), "--log-failed"],
                             cwd=ROOT, capture_output=True, text=True).stdout
        # the tail below can cut a job's lines: its name is kept whole on a line of its own
        jobs = sorted({ln.split("\t", 1)[0].strip().lower() for ln in log.splitlines() if "\t" in ln})
        marker.write_text(f"{branch} {run['headSha']} run {run['databaseId']} "
                          f"{run['conclusion']}\njobs: {','.join(jobs)}\n" + "\n".join(log.splitlines()[-200:]) + "\n")
        print(f"RED {key}: {branch} run {run['databaseId']} — {marker}")

    latest = {m["branch"]: [r for r in gh_runs(m["branch"]) if r.get("status") == "completed"][:1]
              for m in rm.get("milestones", [])}
    green = {b: runs[0]["headSha"] for b, runs in latest.items()
             if runs and runs[0].get("conclusion") == "success"}
    for _, s in stories(rm):
        task = worktree_path(s["id"]) / "task.json"
        if not task.exists():
            continue
        pkt = json.loads(task.read_text())
        sha = pkt.get("submitted_sha")
        run = next((r for r in gh_runs(pkt["branch"]) if sha and r.get("headSha") == sha), None)
        if not run or run.get("status") != "completed":
            continue
        # A merged story's red run is moot once the milestone is green on a commit holding its
        # squash: E22-S12's branch failed on a test fixed on the milestone (22 Oct), and the
        # marker resumed its author for a fix on every tick.
        mb = pkt.get("milestone_branch")
        superseded = s["st"] == "done" and mb in green and merged_in(s["id"], green[mb])
        if run.get("conclusion") == "success" or superseded:
            (scratch / f"{s['id']}.ci-red").unlink(missing_ok=True)
            if s["st"] == "done":
                cmd_reap([s["id"]])
        elif run.get("conclusion") != "cancelled":
            mark(s["id"], pkt["branch"], run)
    for m in rm.get("milestones", []):
        runs = latest[m["branch"]]
        if runs and runs[0].get("conclusion") == "success":
            (scratch / f"{m['id']}.ci-red").unlink(missing_ok=True)
        elif runs and runs[0].get("conclusion") != "cancelled":
            mark(m["id"], m["branch"], runs[0])


def merged_in(sid, sha):
    """Whether commit `sha` contains the story's squash commit (subject starts with its id)."""
    r = subprocess.run(["git", "log", "-1", "--format=%H", f"--grep=^{sid}:", sha],
                       cwd=ROOT, capture_output=True, text=True)
    return r.returncode == 0 and bool(r.stdout.strip())


def gh_runs(branch):
    r = subprocess.run(["gh", "run", "list", "--workflow", "CI", "--branch", branch, "--limit", "10",
                        "--json", "headSha,status,conclusion,databaseId"],
                       cwd=ROOT, capture_output=True, text=True)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []


def cmd_check(argv):
    sys.exit(0 if checked(Path.cwd(), "light" if "--light" in argv else "full") else 1)


COMPOSE = ROOT / "compose.yaml"
STACK_SERVICES = ("postgres", "seaweedfs", "mailpit")


def _container_cli():
    # podman is the documented runtime; OrbStack/Docker (`docker compose`) is the macOS fallback.
    return os.environ.get("FLO_CONTAINER_CLI") or next(
        (c for c in ("podman", "docker") if shutil.which(c)), "podman"
    )


def _run_compose(*args, capture_output=False):
    if not COMPOSE.exists():
        die("compose.yaml missing — story E01-S02 delivers it")
    cmd = [_container_cli(), "compose", "-f", str(COMPOSE), *args]
    try:
        return subprocess.run(cmd, check=True, capture_output=capture_output, text=True)
    except FileNotFoundError:
        die("podman or docker is required for the local stack but neither was found on PATH")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "no error output").strip()
        die(f"{' '.join(cmd)} failed: {detail}")


def _container_status(service, include_stopped=False):
    ps_args = ["ps"]
    if include_stopped:
        ps_args.append("--all")
    ps_args.extend(["--quiet", service])
    result = _run_compose(*ps_args, capture_output=True)
    container_ids = result.stdout.splitlines()
    if not container_ids:
        return None, None, None
    inspect = subprocess.run(
        [
            _container_cli(),
            "inspect",
            "--format",
            "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.ExitCode}}",
            container_ids[0],
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if inspect.returncode:
        return None, None, None
    status, health, exit_code = inspect.stdout.strip().split("|", maxsplit=2)
    return status, health or None, int(exit_code)


def _wait_for_stack(timeout_seconds=120):
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        services = {service: _container_status(service) for service in STACK_SERVICES}
        for service, (status, health, _) in services.items():
            if health == "unhealthy" or status in {"dead", "exited"}:
                die(f"{service} failed while the local stack was starting ({health or status})")
        if all(health == "healthy" for _, health, _ in services.values()):
            return
        time.sleep(1)
    die(f"local stack did not become healthy within {timeout_seconds} seconds")


def _ensure_bucket():
    python = ROOT / "apps" / "api" / ".venv" / "bin" / "python"
    if not python.exists():
        die("apps/api/.venv is missing; run `uv sync --frozen` in apps/api first")
    env = {
        "S3_ENDPOINT_URL": "http://localhost:9000",
        "S3_ACCESS_KEY_ID": "flo",
        "S3_SECRET_ACCESS_KEY": "flo-local-secret",
        "S3_BUCKET": "flo-attachments",
        "S3_REGION": "us-east-1",
        "STORAGE_PROVIDER": "local",
        **os.environ,
    }
    subprocess.run(
        [str(python), "-m", "flo.kernel.storage", "ensure-bucket"],
        check=True,
        env=env,
        cwd=ROOT / "apps" / "api",
    )


def cmd_up(argv):
    if argv not in ([], ["--reset"]):
        die("usage: flo up [--reset]")
    if argv == ["--reset"]:
        _run_compose("down", "--volumes", "--remove-orphans")
    _run_compose("up", "-d", *STACK_SERVICES)
    _wait_for_stack()
    _ensure_bucket()
    print("Postgres:     postgresql://localhost:5432/flo_dev")
    print("Object store: http://localhost:9000")
    print("Mailpit UI:  http://localhost:8025")


def cmd_down(argv):
    if argv:
        die("usage: flo down")
    _run_compose("down")


def cmd_design(argv):
    if not argv:
        die("usage: flo design <MILESTONE_ID>")
    mid = argv[0]
    rm = roadmap()
    eps = [e for e in rm["epics"] if e["milestone"] == mid]
    if not eps:
        die(f"unknown milestone {mid}")
    ss = [(e, s) for e in eps for s in e["stories"]]
    print(f"OPUS BATCH DESIGN — {mid} ({len(ss)} stories)\n")
    print("Write design/<STORY_ID>.md for each story below, in this order, in ONE pass.")
    print("Format: agents/plan.md §3. Inline the requirement text — coding agents must not")
    print("need to open docs/requirements.md. If a packet needs an undecided business rule,")
    print("mark the story blocked and surface the question. Never guess at money, state")
    print("transitions, or authorization.\n")
    for e, s in ss:
        print(f"  {s['id']}  [{s['k']}/{s['s']}] {s['t']}")
        print(f"           requirements: {', '.join(s['reqs'])}")
        if s.get("dep"):
            print(f"           after: {', '.join(s['dep'])}")


COMMANDS = {
    "next": cmd_next, "start": cmd_start, "assign": cmd_assign, "submit": cmd_submit,
    "review": cmd_review, "gate": cmd_gate, "final": cmd_final, "escalate": cmd_escalate,
    "done": cmd_done, "design": cmd_design, "status": cmd_status, "budget": cmd_budget,
    "roadmap": cmd_roadmap, "score": cmd_score, "session": cmd_session, "board": cmd_board,
    "reap": cmd_reap, "account": cmd_account, "launch-model": cmd_launch_model, "preflight": cmd_preflight, "reassign": cmd_reassign, "codex-usage": cmd_codex_usage, "codex-guard": cmd_codex_guard, "release-packet": cmd_release_packet, "log-guard": cmd_log_guard, "ci-watch": cmd_ci_watch, "facts": cmd_facts, "round": cmd_round, "ack": cmd_ack, "unack": cmd_unack, "check": cmd_check, "db": cmd_db, "up": cmd_up, "down": cmd_down,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r}\n{__doc__}")
    COMMANDS[cmd](sys.argv[2:])
