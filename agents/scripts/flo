#!/usr/bin/env python3
"""flo — XLR8 FLO delivery orchestrator.

Every rule in AGENTS.md that can be machine-checked lives here instead of in prose.
Stdlib only, except PyYAML for the two config files.

  flo next                  next story whose dependencies are satisfied
  flo preflight <STORY_ID> --reviewer NAME --verdict pass|fail   file the packet pre-flight flo start requires
  flo start   <STORY_ID>    branch + worktree + task packet (refuses without a passing pre-flight record)
  flo reassign <STORY_ID> [--reason T]   new author for a story whose worker is gone (live pid, dirty tree, own commits: refused)
  flo assign  <STORY_ID>    compute author and two reviewers from agents.yaml
  flo submit  <STORY_ID>    mark ready for review, print reviewer commands
  flo review  <STORY_ID>    print the reviewer packet (diff + design + requirements)
  flo gate    <STORY_ID>    Definition of Done, machine-checked
  flo final   <STORY_ID>    Opus final-review packet (gated stories)
  flo escalate<STORY_ID>    hand the story to Opus for arbitration
  flo done    <STORY_ID>    squash-merge into the milestone branch, update roadmap
  flo design  <MILESTONE>   print the Opus batch-design brief for a milestone
  flo status                roadmap state and in-flight stories
  flo score   [--check]     agent performance scorecard (author + reviewer)
  flo score   --durations   median stage durations by kind, author and reviewer (stdout only)
  flo session <AGENT> [ID]  record an agent's session id for the current story
  flo budget                per-agent spend and remaining capacity
  flo roadmap [--check]     regenerate docs/claude-plan.md §5 (or verify it)
  flo board   [--watch [S]] refresh .flo/status.json and board.html from git refs, worktrees, GitHub\n  flo ack     [KEY|all]     confirm a 'waiting on you' item (list keys with no argument)\n  flo unack   <KEY|all>     reopen a confirmed item
  flo check [--light]       everything CI runs, locally (stops at the first red); --light is\n                            the story gate: no full pytest/e2e, only the tests the story touched\n  flo reap    <STORY_ID>    drop a merged story's worktree once its CI is green\n  flo account <STORY_ID>    account + session id for a multi-account author (sonnet)\n  flo ci-watch              one pass: mark red story/milestone CI, reap green merged stories\n  flo facts                 delivery state as JSON for the fleet supervisor (~/.claude/fleet)\n  flo round   <STORY_ID>    write the next review-round file from the verdicts; print its path
  flo launch-model <STORY_ID> [--reviewer NAME] [--effort]   the model (or effort) agents.yaml names for a launch; recorded in task.json
  flo db      [url|reset]   this worktree's test database (reset drops and recreates it)
  flo up [--reset]          start local Postgres + SeaweedFS + Mailpit; optionally reset data
  flo down                  stop the local stack
"""
import ast
import hashlib
import json
import os
import re
import shutil
import statistics
import subprocess
import sys
import time
import uuid
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path

# FLO_ROOT points this code at another checkout (a dry run of new flo code against the runner's state).
ROOT = Path(os.environ.get("FLO_ROOT") or Path(__file__).resolve().parents[2]).expanduser().resolve()
ROADMAP = ROOT / "agents" / "roadmap.yaml"
FLEET = ROOT / "agents" / "agents.yaml"
PLAN = ROOT / "docs" / "claude-plan.md"
MEMORY = ROOT / "agents" / "project-memory.md"
STATE = ROOT / "agents" / ".state.json"
SCORECARD = ROOT / "agents" / "scorecard.json"
SCORE_MD = ROOT / "agents" / "SCORECARD.md"
BOARD = ROOT / "board.html"  # overridden to the primary checkout by _board_once
sys.path.insert(0, str(Path(__file__).resolve().parent))
TERMINAL = {"done"}
ACTIVE = {"design", "in_progress", "review", "blocked"}
# Judgement day for Sonnet on gated work (docs/ops/sonnet-round-churn.md): the tags that make a story
# gated mirror policy.opus_final_required_tags in agents.yaml (a test keeps them equal), and the
# scorecard shows progress toward JUDGEMENT_FLOOR verified gated Sonnet records.
GATED_TAGS = ("money", "auth", "security", "migration", "concurrency")
JUDGEMENT_FLOOR = 10


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def load_yaml(path):
    try:
        import yaml
    except ImportError:
        die("PyYAML required: pip install pyyaml")
    with open(path) as fh:
        return yaml.safe_load(fh)


def roadmap():
    return load_yaml(ROADMAP)


def stories(rm):
    for epic in rm["epics"]:
        for st in epic["stories"]:
            yield epic, st


def find(rm, sid):
    for epic, st in stories(rm):
        if st["id"] == sid:
            return epic, st
    die(f"unknown story {sid}")


def state():
    return json.loads(STATE.read_text()) if STATE.exists() else {"stories": {}, "spend": {}}


def save_state(s):
    STATE.write_text(json.dumps(s, indent=2, sort_keys=True) + "\n")


def git(*args, cwd=None, check=True):
    r = subprocess.run(["git", *args], cwd=cwd or ROOT, capture_output=True, text=True)
    if check and r.returncode:
        die(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:48]


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def _epoch(iso):
    """Seconds since the epoch for an ISO-8601 string with offset; None when absent or malformed."""
    try:
        return datetime.strptime(iso, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (TypeError, ValueError):
        return None


def durations_from(pkt, verdict_mtimes, review_starts, warn=None):
    """Stage durations for one story, in whole seconds. A key whose inputs are missing, or whose
    interval is negative (clock skew), is omitted: a 0 would pull every median down."""
    out = {}

    def span(key, begin, end):
        if begin is None or end is None:
            return None
        if end < begin:
            if warn:
                warn(f"{key}: end is before start, not recorded")
            return None
        return round(end - begin)

    start, sub, done = (_epoch(pkt.get(k)) for k in ("started_at", "submitted_at", "done_at"))
    for key, begin, end in (("wall_s", start, done), ("author_s", start, sub)):
        value = span(key, begin, end)
        if value is not None:
            out[key] = value
    review = {}
    for who, ended in verdict_mtimes.items():
        value = span(f"review_s[{who}]", review_starts.get(who), ended)
        if value is not None:
            review[who] = value
    if review:
        out["review_s"] = review
    gate = pkt.get("gate_seconds")
    if isinstance(gate, (int, float)) and gate >= 0:
        out["gate_s"] = round(gate)
    return out


def worktree_path(sid):
    return ROOT.parent / f"{ROOT.name}-{sid}"


def milestone_of(rm, epic):
    for m in rm["milestones"]:
        if m["id"] == epic["milestone"]:
            return m
    die(f"unknown milestone {epic['milestone']}")


def start_base(ms, sid):
    """The branch a story starts from and merges into. `main` takes no story merges (milestone PRs
    only), so a milestone whose branch is main (MT, delivery tooling) rides the milestone branch the
    runner has checked out; the local main ref is never refreshed and once cut E23-S09 from M0."""
    if ms["branch"] != "main":
        return ms["branch"]
    head = git("rev-parse", "--abbrev-ref", "HEAD")
    if not head.startswith("milestone/"):
        die(f"{sid}: {ms['id']} stories ride a milestone branch; check out milestone/* first (on {head})")
    return head


# ── planning ─────────────────────────────────────────────────────────────────

def deps_satisfied(rm, st):
    done = {s["id"] for _, s in stories(rm) if s["st"] == "done"}
    return all(d in done for d in st.get("dep", []))


def preflight_state(sid):
    """(record, None) when a passing pre-flight was filed for the packet exactly as it is now,
    else (None, reason). The record proves a pass was filed for this packet text, not that the
    pre-flight was good (ponytail: measure the packet amendment rate after start before adding
    quality scoring here)."""
    packet = ROOT / "design" / f"{sid}.md"
    path = ROOT / ".scratch" / f"{sid}.preflight.json"
    if not path.exists():
        return None, "no pre-flight record"
    try:
        rec = json.loads(path.read_text())
    except json.JSONDecodeError:
        return None, "pre-flight record is unreadable"
    if rec.get("story") != sid:
        return None, "pre-flight record is for another story"
    if rec.get("verdict") != "pass":
        return None, f"pre-flight verdict is {rec.get('verdict')!r}, not 'pass'"
    if not packet.exists() or rec.get("packet_sha256") != hashlib.sha256(packet.read_bytes()).hexdigest():
        return None, "packet changed since pre-flight"
    return rec, None


def cmd_preflight(argv):
    """flo preflight <STORY_ID> --reviewer NAME --verdict pass|fail [--findings N]: file the
    result of a packet pre-flight (the packet checked against the real code) so flo start can
    require it. The hash is taken now, so a later edit to the packet invalidates the record."""
    usage = "usage: flo preflight <STORY_ID> --reviewer NAME --verdict pass|fail [--findings N]"
    args = list(argv)

    def option(name, default=None):
        if name not in args:
            return default
        i = args.index(name)
        if i + 1 >= len(args):
            die(usage)
        value = args[i + 1]
        del args[i:i + 2]
        return value

    reviewer, verdict, findings = option("--reviewer"), option("--verdict"), option("--findings", "0")
    if len(args) != 1 or not reviewer or verdict not in ("pass", "fail") or not findings.isdigit():
        die(usage)
    sid = args[0]
    find(roadmap(), sid)
    if reviewer not in (load_yaml(FLEET).get("agents") or {}):
        die(f"{reviewer}: not in agents/agents.yaml")
    packet = ROOT / "design" / f"{sid}.md"
    if not packet.exists():
        die(f"no design packet at design/{sid}.md")
    rec = {"story": sid, "packet_sha256": hashlib.sha256(packet.read_bytes()).hexdigest(),
           "reviewer": reviewer, "verdict": verdict, "at": now_iso(), "findings": int(findings)}
    path = ROOT / ".scratch" / f"{sid}.preflight.json"
    path.parent.mkdir(exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(rec, indent=2) + "\n")
    os.replace(tmp, path)
    print(f"{sid}: pre-flight {verdict} by {reviewer} recorded for packet {rec['packet_sha256'][:10]}")


def cmd_next(argv):
    rm, fleet = roadmap(), load_yaml(FLEET)
    cap = fleet["policy"]["max_stories_in_flight"]
    in_flight = [s for _, s in stories(rm) if s["st"] in ACTIVE]
    if len(in_flight) >= cap:
        print(f"{len(in_flight)}/{cap} stories in flight — finish one before starting another:")
        for s in in_flight:
            print(f"  {s['id']}  [{s['st']}]  {s['t']}")
        return
    ready = [(e, s) for e, s in stories(rm) if s["st"] == "todo" and deps_satisfied(rm, s)]
    if not ready:
        blocked = [s for _, s in stories(rm) if s["st"] == "todo"]
        die("no story is ready" + (f" ({len(blocked)} todo, all dependency-blocked)" if blocked else " — roadmap complete"))
    epic, st = ready[0]
    print(f"{st['id']}  {st['t']}")
    print(f"  epic {epic['id']} {epic['name']} · milestone {epic['milestone']} · {st['k']}/{st['s']}")
    print(f"  requirements: {', '.join(st['reqs'])}")
    print(f"\n  flo start {st['id']}")


def assignment_for(epic, st, fleet, sp, exclude=()):
    """The author, reviewers and opus_final that `flo assign` chooses for a story, never picking an
    agent in `exclude`. The one place eligibility lives: `flo reassign` calls it too, so it cannot
    hand a story to an agent `flo assign` would have refused. Exits when nobody qualifies."""
    sid = st["id"]
    pol, agents = fleet["policy"], fleet["agents"]
    tags = set(st.get("tags", []))

    # Step 0 — a milestone override wins outright over the capacity heuristic.
    ov = (fleet.get("milestone_overrides") or {}).get(epic["milestone"])
    if ov:
        author = ov["sole_author"]
        if author in exclude:
            die(f"{sid}: milestone override makes {author} the sole author — no other agent may take it")
        if st["k"] not in agents[author].get("allowed_kinds", []):
            die(f"{sid}: milestone override makes {author} sole author but kind="
                f"{st['k']} is not in its allowed_kinds — widen it in agents.yaml")
        reviewers = [r for r in ov["reviewers"] if r != author]
        if len(reviewers) < pol["min_reviewers"]:
            die(f"override for {epic['milestone']} leaves {len(reviewers)} reviewer(s); "
                f"minimum is {pol['min_reviewers']}")
        return {"author": author, "reviewers": reviewers,
                "opus_final": bool(ov.get("opus_final_all")) or bool(tags & set(pol["opus_final_required_tags"])),
                "override": epic["milestone"]}

    size_rank = {"S": 1, "M": 2, "L": 3}
    scarcity = {"none": 0, "spend": 1, "rate": 2}

    def can_author(name, cfg):
        if name in exclude:
            return False
        if "author" not in cfg.get("roles", []):
            return False
        if st["k"] not in cfg.get("allowed_kinds", []):
            return False
        if tags & set(cfg.get("avoid_tags", [])):
            return False
        cap = cfg.get("max_author_size")
        if cap and size_rank[st["s"]] > size_rank[cap]:
            return False
        if cfg.get("accounts") and not free_accounts(name, cfg):
            return False  # every worker slot on every account is busy: overflow to the next author
        if cfg.get("monthly_budget_usd"):
            spent = sp.get(name, 0.0)
            usable = cfg["monthly_budget_usd"] - cfg.get("reserve_for_review_usd", 0)
            if spent >= usable:
                return False
        return True

    cands = [n for n, c in agents.items() if can_author(n, c)]
    if not cands:
        die(f"no agent may author kind={st['k']} size={st['s']} — check allowed_kinds in agents.yaml")

    def rank(n):
        c = agents[n]
        prefers = bool(tags & set(c.get("prefer_tags", [])))
        return (0 if prefers else 1, scarcity[c.get("metered", "none")])

    # 13 Oct 2026: an explicit author_priority (sonnet, then the overflow lanes) replaces the
    # scarcity heuristic when it is set.
    prio = pol.get("author_priority")
    author = (next(n for n in prio + sorted(cands, key=rank) if n in cands) if prio
              else sorted(cands, key=rank)[0])
    # Every story gets one reviewer from ungated_reviewers that is not its author (codex, then
    # qwen). A gated story additionally needs Opus (opus_final), in a fresh session.
    opus_final = bool(tags & set(pol["opus_final_required_tags"]))
    reviewers = [n for n in pol["ungated_reviewers"]
                 if n != author and sp.get(n, 0.0) < agents[n].get("monthly_budget_usd", float("inf"))][:1]
    if len(reviewers) < pol["min_reviewers"]:
        die(f"only {len(reviewers)} reviewer(s) available; minimum is {pol['min_reviewers']} — story waits")
    return {"author": author, "reviewers": reviewers, "opus_final": opus_final}


def cmd_assign(argv):
    """Implements the algorithm documented at the foot of agents/agents.yaml."""
    if not argv:
        die("usage: flo assign <STORY_ID>")
    rm, fleet = roadmap(), load_yaml(FLEET)
    epic, st = find(rm, argv[0])
    out = assignment_for(epic, st, fleet, state().get("spend", {}))
    print(json.dumps(out, indent=2))
    return out


@contextmanager
def story_lock(sid):
    """One launch or reassign per story at a time: an atomic mkdir, the convention finish.sh uses
    and author.sh takes too. ponytail: a crash leaves the directory behind; remove
    .scratch/<story>.lock by hand (macOS has no flock(1), so no kernel-released lock)."""
    lock = ROOT / ".scratch" / f"{sid}.lock"
    lock.parent.mkdir(exist_ok=True)
    try:
        lock.mkdir()
    except FileExistsError:
        die(f"{sid}: {lock} is held by a launch or another reassign; if none is running, remove it")
    try:
        yield
    finally:
        lock.rmdir()


def cmd_reassign(argv):
    """flo reassign <STORY_ID> [--reason TEXT]: give a story whose author is not running to the
    agent `flo assign` would pick without the current one. Refuses unless the worker is gone, the
    worktree is clean with no commit of its own, and nobody else holds the story lock."""
    usage = "usage: flo reassign <STORY_ID> [--reason TEXT]"
    args, reason = list(argv), "reassign"
    if "--reason" in args:
        i = args.index("--reason")
        if i + 1 >= len(args):
            die(usage)
        reason = args[i + 1]
        del args[i:i + 2]
    if len(args) != 1:
        die(usage)
    sid = args[0]
    epic, st = find(roadmap(), sid)
    if st["st"] not in ("design", "in_progress"):
        die(f"{sid} is {st['st']}: only a story whose author has not submitted can be reassigned")
    task = worktree_path(sid) / "task.json"
    if not task.exists():
        die(f"no task packet for {sid} — run: flo start {sid}")
    seen = json.loads(task.read_text())["author"]  # read before the lock: see _reassign_locked
    with story_lock(sid):
        _reassign_locked(sid, epic, st, seen, reason)


def _reassign_locked(sid, epic, st, seen, reason):
    wt = worktree_path(sid)
    task = wt / "task.json"
    pkt = json.loads(task.read_text())
    # a second reassign that waited for the lock saw the old author: refuse rather than move it again
    if pkt["author"] != seen:
        die(f"{sid}: author changed from {seen} to {pkt['author']} while waiting — already reassigned")
    # task.json and reviews/ are gitignored, so a clean tree says nothing about a running worker
    if _alive(ROOT / ".scratch" / f"{sid}.author.pid"):
        die(f"{sid}: {seen}'s worker is still running — not reassigned")
    if git("status", "--porcelain", cwd=wt):
        die(f"{sid}: the worktree has uncommitted changes — not reassigned")
    ahead = git("rev-list", "--count", f"{pkt['milestone_branch']}..HEAD", cwd=wt)
    if ahead != "0":
        die(f"{sid}: {ahead} commit(s) past {pkt['milestone_branch']} — not reassigned")
    new = assignment_for(epic, st, load_yaml(FLEET), state().get("spend", {}), exclude={seen})
    pkt["author"], pkt["reviewers"], pkt["opus_final"] = new["author"], new["reviewers"], new["opus_final"]
    pkt.setdefault("substitutions", []).append({"from": seen, "to": new["author"], "reason": reason})
    task.write_text(json.dumps(pkt, indent=2) + "\n")
    print(f"{sid}: {seen} -> {new['author']}; reviewers {', '.join(new['reviewers'])}; "
          f"opus final {'required' if new['opus_final'] else 'not required'}")


def worker_load(name):
    """Stories whose author is working, per account, for an agent on several accounts (sonnet).

    A story in review or finishing holds no author session; counting it (19 Oct) filled both
    accounts and sent E11-S10 to the overflow lane while account B sat idle.
    """
    load = {}
    for _, s in stories(roadmap()):
        if s["st"] not in {"design", "in_progress"}:
            continue
        task = worktree_path(s["id"]) / "task.json"
        if not task.exists():
            continue
        pkt = json.loads(task.read_text())
        acct = ((pkt.get("sessions") or {}).get(name) or {}).get("account")
        if pkt.get("author") == name and acct:
            load[acct] = load.get(acct, 0) + 1
    return load


def free_accounts(name, cfg):
    load = worker_load(name)
    cap = cfg.get("max_workers_per_account", 1)
    return sorted((a for a in cfg["accounts"] if load.get(a, 0) < cap), key=lambda a: load.get(a, 0))


def config_dir(value):
    """`-` for the default login (CLAUDE_CONFIG_DIR unset), else the expanded folder."""
    return "-" if value == "default" else str(Path(value).expanduser())


def cmd_account(argv):
    """Pick the account a multi-account author runs a story on, and its session id.

    Prints `new|resume <config_dir> <session_id>`. The least-loaded account with a free slot
    wins; a tie goes to the account not used last. A story that already has a session keeps it,
    so a continuation, a review round or a CI fix resumes the same conversation.
    """
    if not argv:
        die("usage: flo account <STORY_ID>")
    sid = argv[0]
    pkt, task = packet_of(sid), worktree_path(sid) / "task.json"
    name = pkt["author"]
    cfg = load_yaml(FLEET)["agents"][name]
    rec = (pkt.get("sessions") or {}).get(name) or {}
    if rec.get("id") and rec.get("account"):
        print(f"resume {config_dir(cfg['accounts'][rec['account']])} {rec['id']} {rec['account']}")
        return
    free = free_accounts(name, cfg)
    if not free:
        die(f"{name}: every account is at max_workers_per_account — the story waits")
    load, s = worker_load(name), state()
    last = s.get("last_account", {}).get(name)
    tied = [a for a in free if load.get(a, 0) == load.get(free[0], 0)]
    acct = next((a for a in tied if a != last), tied[0])
    pinned = os.environ.get("FLO_ACCOUNT")  # the planner may pin an account; it must have a slot
    if pinned:
        if pinned not in free:
            die(f"{name}: account {pinned} has no free slot — the story waits")
        acct = pinned
    s.setdefault("last_account", {})[name] = acct
    save_state(s)
    rec = {"agent": name, "id": str(uuid.uuid4()), "source": "launch:--session-id",
           "account": acct, "cwd": str(worktree_path(sid)), "role": "xlr8flo-worker"}
    pkt.setdefault("sessions", {})[name] = rec
    task.write_text(json.dumps(pkt, indent=2) + "\n")
    print(f"new {config_dir(cfg['accounts'][acct])} {rec['id']} {acct}")


def cmd_launch_model(argv):
    """flo launch-model <STORY_ID> [--reviewer NAME] [--effort]: print the model agents.yaml names
    for the story's author (or for NAME) and record it in task.json sessions, so the string a
    launcher uses is the string the scorecard keeps. With --effort, print and record the agent's
    `reasoning` instead. Never falls back to a default."""
    usage = "usage: flo launch-model <STORY_ID> [--reviewer NAME] [--effort]"
    args, reviewer = list(argv), None
    effort = "--effort" in args
    if effort:
        args.remove("--effort")
    if "--reviewer" in args:
        i = args.index("--reviewer")
        if i + 1 >= len(args):
            die(usage)
        reviewer = args[i + 1]
        del args[i:i + 2]
    if not args:
        die(usage)
    task = worktree_path(args[0]) / "task.json"
    # a release review (a milestone id) has no story packet: the value is printed, not recorded
    pkt = json.loads(task.read_text()) if task.exists() else None
    agent = reviewer or (pkt or {}).get("author")
    if not agent:
        die(f"no task packet for {args[0]} and no --reviewer given")
    cfg = (load_yaml(FLEET).get("agents") or {}).get(agent)
    if not cfg:
        die(f"{agent}: not in agents/agents.yaml")
    key, field = ("reasoning", "effort") if effort else ("model", "model")
    value = cfg.get(key)
    if not value:
        die(f"{agent}: agents/agents.yaml names no {key} for it")
    if pkt is not None:
        rec = pkt.setdefault("sessions", {}).setdefault(
            agent, {"agent": agent, "id": None, "source": "launch-model"})
        rec[field] = value
        task.write_text(json.dumps(pkt, indent=2) + "\n")
    print(value)


def cmd_codex_usage(argv):
    """Append Codex's cap reading after a review to .scratch/codex-usage.jsonl, so the pilot can
    say what one review costs and how soon four lanes reach the cap. Source: the rate_limits
    lines Codex writes into its own session logs (what its /status shows)."""
    if len(argv) < 2:
        die("usage: flo codex-usage <STORY_ID> <started-iso>")
    root = Path.home() / ".codex" / "sessions"
    files = sorted(root.glob("*/*/*/rollout-*.jsonl"), key=lambda f: f.stat().st_mtime)[-8:]
    lines = [ln for f in files for ln in f.read_text().splitlines()[-300:] if '"rate_limits"' in ln]
    # Codex also logs a per-model "premium" limit with null windows; only the account's
    # five-hour and weekly windows answer how close the cap is.
    readings = [j for j in map(json.loads, lines)
                if ((j.get("payload") or {}).get("rate_limits") or {}).get("primary")]
    latest = max(readings, key=lambda j: j.get("timestamp", ""), default={})
    limits = (latest.get("payload") or {}).get("rate_limits") or {}
    # The model and effort the review ran, from its own log header (`model:`, `reasoning effort:`),
    # not from the rollouts: Codex's internal codex-auto-review session writes those too.
    log = ROOT / ".scratch" / f"{argv[0]}.codex.log"
    head = log.read_text(errors="replace").splitlines()[:40] if log.exists() else []
    ran = {k: v.strip() for k, _, v in (ln.partition(":") for ln in head)
           if k in ("model", "reasoning effort")}
    ran["effort"] = ran.pop("reasoning effort", None)
    rec = {"story": argv[0], "start": argv[1], "end": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
           "model": ran.get("model"), "effort": ran.get("effort"),
           "five_hour": limits.get("primary"), "weekly": limits.get("secondary")}
    out = ROOT / ".scratch" / "codex-usage.jsonl"
    out.parent.mkdir(exist_ok=True)
    with out.open("a") as f:
        f.write(json.dumps(rec) + "\n")
    print(json.dumps(rec))


# ── story lifecycle ──────────────────────────────────────────────────────────

def cmd_start(argv):
    if not argv:
        die("usage: flo start <STORY_ID>")
    sid = argv[0]
    rm = roadmap()
    epic, st = find(rm, sid)
    if st["st"] != "todo":
        die(f"{sid} is {st['st']}, not todo")
    if not deps_satisfied(rm, st):
        pending = [d for d in st.get("dep", []) if find(rm, d)[1]["st"] != "done"]
        die(f"{sid} depends on unfinished: {', '.join(pending)}")
    design = ROOT / "design" / f"{sid}.md"
    if not design.exists():
        die(f"no design packet at design/{sid}.md — run: flo design {epic['milestone']}")
    preflight, why = preflight_state(sid)
    if not preflight:
        die(f"{sid}: {why} — pre-flight the packet against the code, then run: "
            f"flo preflight {sid} --reviewer NAME --verdict pass")

    base = start_base(milestone_of(rm, epic), sid)
    branches = git("branch", "--list", base)
    if not branches:
        git("branch", base)
    branch = f"story/{sid}-{slug(st['t'])}"
    wt = worktree_path(sid)
    if wt.exists():
        die(f"worktree already exists: {wt}")
    git("worktree", "add", "-b", branch, str(wt), base)

    assignment = cmd_assign([sid])
    packet = {
        "story": sid, "title": st["t"], "epic": epic["id"], "milestone": epic["milestone"],
        "kind": st["k"], "size": st["s"], "tags": st.get("tags", []),
        "requirements": st["reqs"], "depends_on": st.get("dep", []),
        "branch": branch, "milestone_branch": base, "worktree": str(wt),
        "started_at": now_iso(), "preflight": preflight, "evidence_required": True,
        "design": f"design/{sid}.md", **assignment,
        "rounds": 0, "substitutions": [], "notes": {"blocked": None, "followup": [], "recap": None},
        "traceability": {},
    }
    packet["sessions"] = {assignment["author"]: detect_session(assignment["author"], wt)}
    (wt / "task.json").write_text(json.dumps(packet, indent=2) + "\n")
    set_status(sid, "in_progress")
    print(f"\nworktree  {wt}\nbranch    {branch}\ndesign    design/{sid}.md")
    print(f"author    {assignment['author']}\nreviewers {', '.join(assignment['reviewers'])}"
          f"\nopus final{'  required' if assignment['opus_final'] else '  not required'}")
    if assignment.get("override"):
        print(f"override  {assignment['override']} — sole author by milestone policy "
              f"(agents/agents.yaml milestone_overrides)")
    print(f"\n  cd {wt} && cat design/{sid}.md")


def packet_of(sid):
    p = worktree_path(sid) / "task.json"
    if not p.exists():
        die(f"no task packet for {sid} — run: flo start {sid}")
    return json.loads(p.read_text())


def cmd_submit(argv):
    if not argv:
        die("usage: flo submit <STORY_ID>")
    sid = argv[0]
    wt = worktree_path(sid)
    if not checked(wt, "light"):
        die("flo check --light is red — fix before submitting; two of four agents are rate-limited")
    pkt = packet_of(sid)
    rec = detect_session(pkt["author"], wt)
    if rec["id"] and not ((pkt.get("sessions") or {}).get(pkt["author"]) or {}).get("id"):
        pkt.setdefault("sessions", {})[pkt["author"]] = rec
    # Hosted CI runs the full suite on this exact commit while the reviewers work, so the
    # gate can ask GitHub instead of re-running 25 minutes of pytest on a loaded workstation.
    pkt["submitted_sha"] = git("rev-parse", "HEAD", cwd=wt)
    if pkt.get("submitted_at"):
        pkt.setdefault("resubmitted_at", []).append(now_iso())  # author_s stays the first submit
    else:
        pkt["submitted_at"] = now_iso()
    git("push", "-u", "origin", pkt["branch"], cwd=wt)
    (wt / "task.json").write_text(json.dumps(pkt, indent=2) + "\n")
    set_status(sid, "review")
    print(f"{sid} ready for review. Reviewers must run:\n")
    for r in pkt["reviewers"]:
        print(f"  {r}:  flo review {sid}   → reviews/{sid}.{r}.json")


# Machine-generated files. A reviewer reading them line by line learns nothing and
# pays for every token. uv.lock alone was 1,108 of 3,178 packet lines on E01-S05 and
# stalled two reviewers before their first output.
GENERATED_FILES = (
    "uv.lock", "package-lock.json", "pnpm-lock.yaml", "yarn.lock",
    "poetry.lock", "Cargo.lock", "go.sum", "Gemfile.lock", "composer.lock",
    "openapi.json", "schema.ts",  # the generated API client; the light gate checks it is current
)


def _module_file(wt, module):
    """flo.a.b -> apps/api/src/flo/a/b.py (or its package); tests.a -> apps/api/tests/a.py."""
    base = wt / "apps" / "api" / ("src" if module.split(".")[0] == "flo" else "")
    path = base.joinpath(*module.split("."))
    for f in (path.with_suffix(".py"), path / "__init__.py"):
        if f.is_file():
            return f
    return None


def _signature(node):
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
        ret = f" -> {ast.unparse(node.returns)}" if node.returns else ""
        return f"def {node.name}({ast.unparse(node.args)}){ret}"
    bases = ", ".join(ast.unparse(b) for b in node.bases)
    fields = [ast.unparse(st.target) + ": " + ast.unparse(st.annotation)
              for st in node.body if isinstance(st, ast.AnnAssign)]
    methods = [st.name for st in node.body
               if isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef)) and not st.name.startswith("_")]
    out = f"class {node.name}({bases})" if bases else f"class {node.name}"
    if fields:
        out += " { " + "; ".join(fields[:10]) + (" ..." if len(fields) > 10 else "") + " }"
    if methods:
        out += " methods: " + ", ".join(methods[:6]) + (" ..." if len(methods) > 6 else "")
    return out


def _find_def(wt, module, name, hops=2):
    f = _module_file(wt, module)
    if f is None:
        return None
    tree = ast.parse(f.read_text())
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and node.name == name:
            # an enum, protocol or exception with no fields says nothing a name does not
            if isinstance(node, ast.ClassDef) and not any(isinstance(st, ast.AnnAssign) for st in node.body) \
                    and {ast.unparse(b).split("[")[0] for b in node.bases} & {"StrEnum", "Enum", "Protocol", "Exception"}:
                return None
            sig = _signature(node)
            sig = sig if len(sig) <= 160 else sig[:157] + "..."
            return f"{sig}  — {f.relative_to(wt)}:{node.lineno}"
    if hops:  # a re-export: follow the package's own import of the name
        for node in tree.body:
            if isinstance(node, ast.ImportFrom) and node.module and any(a.name == name for a in node.names):
                return _find_def(wt, node.module, name, hops - 1)
    return None


def called_signatures(wt, rng, added_files):
    """Signatures of repository functions and classes the diff's Python uses but does not add,
    so a reviewer does not search the tree for them. ponytail: Python only, by-name imports;
    add TypeScript and attribute calls if reviews keep searching for those."""
    diff = git("diff", "-U0", rng, "--", "*.py", cwd=wt, check=False)
    added = "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
    files = {l[6:] for l in diff.splitlines() if l.startswith("+++ b/")}
    out = {}
    for rel in sorted(files):
        f = wt / rel
        if not f.is_file():
            continue
        try:
            tree = ast.parse(f.read_text())
        except SyntaxError:
            continue
        for node in ast.walk(tree):
            if not (isinstance(node, ast.ImportFrom) and node.module
                    and node.module.split(".")[0] in ("flo", "tests")):
                continue
            for a in node.names:
                used = a.asname or a.name
                if used in out or not re.search(rf"\b{re.escape(used)}\b", added):
                    continue
                target = _module_file(wt, node.module)
                if target is None or str(target.relative_to(wt)) in added_files:
                    continue
                sig = _find_def(wt, node.module, a.name)
                if sig:
                    out[used] = sig
    return sorted(set(out.values()))


def cmd_codex_guard(argv):
    """flo codex-guard <worktree> <max_calls> <pid> [max_seconds]: stop a Codex review past
    max_calls tool calls, past max_seconds of wall-clock time (sleep(1) pauses while the machine
    sleeps, wall time does not), or when its session log has not moved for 5 minutes (a dead
    connection after wake hung E09-S08's review on 13 Oct). Reads only rollouts written after the
    guard started whose session ran in that worktree."""
    wt, cap, pid = argv[0], int(argv[1]), int(argv[2])
    deadline = time.time() + (int(argv[3]) if len(argv) > 3 else 900)
    root, t0, mine = Path.home() / ".codex" / "sessions", time.time(), None
    while True:
        try:
            os.kill(pid, 0)
        except OSError:
            return
        if mine is None:
            for f in sorted(root.glob("*/*/*/rollout-*.jsonl"), key=lambda f: f.stat().st_mtime)[-6:]:
                if f.stat().st_mtime >= t0 - 5 and wt in f.read_text(errors="replace")[:6000]:
                    mine = f
        stop = None
        if time.time() > deadline:
            stop = "stopped at the time cap"
        elif mine is not None and time.time() - mine.stat().st_mtime > 300:
            stop = "stopped: no session activity for 5 minutes"
        if stop:
            os.kill(pid, 15)
            print(stop)
            return
        if mine is not None:
            calls = sum(1 for ln in mine.read_text(errors="replace").splitlines()
                        if '"type":"function_call"' in ln or '"type":"custom_tool_call"' in ln)
            if calls > cap:
                os.kill(pid, 15)
                print(f"stopped at the call cap ({calls} > {cap})")
                return
        time.sleep(15)


RELEASE_FOCUS_ALL = """Read first (highest risk): money and ledger (modules/budget, modules/requisitions/approval.py,
funding.py, lifecycle.py, amendments.py), authorization and tenancy (modules/identity, every
api/*.py route's require/permitted, RLS on every new table in the migrations above), approval
engine (modules/approvals), and the boundaries between modules (a module may import another's
service and schemas only)."""
RELEASE_AREAS = {
    "money": """Your area: MONEY AND LEDGER only. Read apps/api/src/flo/modules/budget/ and
modules/requisitions/{approval,funding,lifecycle,amendments,revisions,codes}.py. Check: every
reserve, release, transfer and allocation happens under the balance lock and inside one
transaction; releases happen exactly once; Decimal only; no float or round(); idempotency keys;
abandoned projects kept out of totals. Ignore UI and the approval engine internals.""",
    "auth": """Your area: AUTHORIZATION AND TENANCY only. Read apps/api/src/flo/api/*.py (each
route's require/permitted), modules/identity/, and the new migrations' RLS/FORCE RLS/policies.
Check: every route authorizes server-side; org_id only from the session; a foreign tenant gets
404; every new tenant table has RLS; permission codes match the catalogue. Ignore UI and money maths.""",
    "approvals": """Your area: THE APPROVAL ENGINE only. Read apps/api/src/flo/modules/approvals/.
Check: version pinning, decisions and their audit, stale-version guard, delegation, workflow
gating (no workflow => refused), adapter on_outcome inside the decision transaction. Ignore UI.""",
    "ui": """Your area: THE WEB UI only. Read apps/web/src/routes and components for requisitions,
approvals, projects and budget. Check against the rules: tokens only (no hardcoded colour,
spacing, radius, duration), keyboard reachable, colour never the only signal, money with tabular
figures and parenthesised negatives, loading/empty/error states, generated API types only.""",
}


def cmd_release_packet(argv):
    """flo release-packet <MILESTONE>: a light release-review packet (no inline diff) for the
    milestone branch against main: goal, exit criteria, stories, a per-area size table, where to
    look first, and how to read only what a suspicion needs."""
    if not argv:
        die("usage: flo release-packet <MILESTONE>[-<area>]  (areas: money, auth, approvals, ui)")
    mid, _, area = argv[0].partition("-")
    vid = argv[0]  # the verdict file's id: M2, or M2-money for an area pass
    rm = load_yaml(ROOT / "agents" / "roadmap.yaml")
    ms = next((m for m in rm["milestones"] if m["id"] == mid), None)
    if ms is None:
        die(f"unknown milestone {mid}")
    stories = [s for e in rm["epics"] if e.get("milestone") == mid for s in e["stories"]]
    done = [s for s in stories if s.get("st") == "done"]
    rng = f"origin/main...{ms['branch']}"
    areas: dict[str, list[int]] = {}
    for ln in git("diff", "--numstat", rng, check=False).splitlines():
        add, rem, path = (ln.split("\t") + ["", "", ""])[:3]
        if path.rsplit("/", 1)[-1] in GENERATED_FILES or not add.isdigit():
            continue
        parts = path.split("/")
        if parts[0] in ("design-system", "design", "docs", ".scratch"):
            key = "(docs) " + parts[0]
        elif path.startswith("apps/api/src/flo/modules/"):
            key = "/".join(parts[:6])
        else:
            key = "/".join(parts[:4]) if path.startswith("apps/") else parts[0]
        a = areas.setdefault(key, [0, 0, 0]); a[0] += 1; a[1] += int(add); a[2] += int(rem)
    migrations = [ln for ln in git("diff", "--name-only", "--diff-filter=A", rng, "--", "migrations",
                                   check=False).splitlines() if ln.endswith(".py")]
    exit_row = next((ln for ln in (ROOT / "docs" / "claude-plan.md").read_text().splitlines()
                     if ln.startswith(f"| **{mid}** |")), "")
    focus = RELEASE_AREAS.get(area)
    if area and focus is None:
        die(f"unknown area {area}; choose from {', '.join(RELEASE_AREAS)}")
    print(f"=== RELEASE REVIEW PACKET {vid} — {ms['name']}" + (f" — area: {area} only" if area else "") + " ===")
    print(f"Goal: {' '.join(str(ms.get('goal', '')).split())}")
    if exit_row:
        print(f"Exit criteria: {exit_row.split('|')[4].strip()}")
    print(f"\nStories merged ({len(done)} of {len(stories)}):")
    for s in done:
        print(f"  {s['id']}  {' '.join(s['t'].split())[:110]}  [{', '.join(s.get('tags') or []) or '-'}]")
    print(f"\nDiff {rng} by area (files, +, -), generated files excluded:")
    for k, (n, a, r) in sorted(areas.items(), key=lambda kv: (kv[0].startswith("(docs)"), -kv[1][1]))[:32]:
        print(f"  {n:4d} {a:7d} {r:6d}  {k}")
    print(f"\nNew migrations ({len(migrations)}): " + ", ".join(m.rsplit('/', 1)[-1][:24] for m in migrations))
    print(f"""
{focus or RELEASE_FOCUS_ALL}

--- how to review (budget: about {25 if area else 40} commands; the run is stopped at a time and call cap) ---
1. You are in a read-only checkout of {ms['branch']}. Do NOT open AGENTS.md, CLAUDE.md, agents/,
   docs/ or design/; this packet is the brief. Do not print the whole diff.
2. Write reviews/{vid}.<your-agent-id>.json at once as a draft. Within your first 8 commands, skim
   the diff stat for your area and add up to 5 suspicions to its findings, each marked
   "unverified" in "problem". Spend the rest confirming or deleting them, updating the file after
   each one. The run can be stopped at any time; the file is what counts.
3. Read only what a suspicion needs, capped:
     git diff {rng} --stat -- <path> | tail -20
     git diff {rng} -- <one file> | head -200
     sed -n 'A,Bp' <file>     grep -rn '<pattern>' <dir> | head -40
4. Static review only: no tests, no plants. Every story was planted and passed the full suite on
   CI, and the milestone branch CI is green. Set "ran_tests": false.
5. Look for what per-story review misses: drift between stories, duplicated helpers, a rule
   enforced in one path but not its sibling, boundary leaks, missing RLS or audit, money moved
   outside a lock or a transaction.
6. Finalise and stop. Exactly this shape; severity blocker | major | minor:
     {{"story": "{vid}", "reviewer": "<your-agent-id>", "verdict": "approve" | "changes_requested",
      "ran_tests": false, "findings": [{{"severity": "major", "file": "path", "line": 1,
      "requirement": "REQ-001", "problem": "what fails", "fix": "what to change"}}]}}
   Report only what you reproduced or traced in the code as it stands. Two failed attempts to
   confirm a suspicion: report it as unverified, never as a blocker.""")


def cmd_log_guard(argv):
    """flo log-guard <log> <max_calls> <pid> <max_seconds>: stop an opencode reviewer past its tool
    call budget, its wall-clock deadline, or 10 minutes without log output. Counts the tool lines
    opencode prints ('$ ' commands and '→ ' reads/edits)."""
    log, cap, pid, secs = Path(argv[0]), int(argv[1]), int(argv[2]), int(argv[3])
    deadline, ansi = time.time() + secs, re.compile(r"\x1b\[[0-9;]*m")
    while True:
        try:
            os.kill(pid, 0)
        except OSError:
            return
        text = ansi.sub("", log.read_text(errors="replace")) if log.exists() else ""
        calls = sum(1 for ln in text.splitlines() if ln.startswith(("$ ", "→ ")))
        stale = log.exists() and time.time() - log.stat().st_mtime > 600
        why = ("stopped at the time cap" if time.time() > deadline else
               f"stopped at the call cap ({calls} > {cap})" if calls > cap else
               "stopped: no output for 10 minutes" if stale else None)
        if why:
            os.kill(pid, 15)
            with log.open("a") as f:
                f.write(why + "\n")
            return
        time.sleep(15)


def cmd_review(argv):
    """flo review <S> [--since <sha> --prior <verdict.json>]: with --since, a re-review packet that
    carries the reviewer's previous findings and only the story's changes since that commit."""
    if not argv:
        die("usage: flo review <STORY_ID> [--since <sha> --prior <verdict.json>]")
    sid = argv[0]
    opts = dict(zip(argv[1::2], argv[2::2]))
    since, prior = opts.get("--since"), opts.get("--prior")
    pkt, wt = packet_of(sid), worktree_path(sid)
    rng = f"{pkt['milestone_branch']}...{pkt['branch']}"
    names = [n for n in git("diff", "--name-only", rng, cwd=wt, check=False).splitlines() if n]
    if since:
        # the story's own files only: submit merges the milestone in, which is not under review
        rng = f"{since}..HEAD"
        changed = set(git("diff", "--name-only", rng, cwd=wt, check=False).split())
        names = [n for n in names if n in changed]
    generated = [n for n in names if n.rsplit("/", 1)[-1] in GENERATED_FILES]
    # Reviewers run in sandboxes that refuse to open dotfiles, and the refusal kills the
    # run rather than degrading it. Inline them instead of letting the reviewer try.
    dotfiles = [n for n in names if n.rsplit("/", 1)[-1].startswith(".") and n not in generated]

    print(f"=== REVIEW PACKET {sid} — {pkt['title']} ===")
    print(f"kind {pkt['kind']} · size {pkt['size']} · tags {', '.join(pkt['tags']) or 'none'}")
    print(f"requirements: {', '.join(pkt['requirements'])}\n")
    if since:
        print(f"--- RE-REVIEW since {since[:10]}: your previous findings ---")
        print(Path(prior).read_text() if prior and Path(prior).exists() else "(none recorded)")
        print("\nThe design packet is not repeated; your findings above and the requirement ids")
        print("define the scope. Open design/ only to settle a disputed acceptance criterion.\n")
        print("--- the story's changes since your last review ---")
    else:
        print("--- design packet ---")
        print((ROOT / pkt["design"]).read_text())
        print("--- diff vs milestone branch ---")
    excludes = [f":(exclude){n}" for n in generated]
    print(git("diff", rng, "--", *(names or ["."]), *excludes, cwd=wt, check=False))

    added_files = set(git("diff", "--name-only", "--diff-filter=A", rng, cwd=wt, check=False).split())
    sigs = called_signatures(wt, rng, added_files)
    if sigs:
        print("--- code the diff calls into (signatures; open the file only if you need the body) ---")
        print("\n".join(sigs) + "\n")

    if generated:
        print("--- generated files, body omitted ---")
        for n in generated:
            print(f"{n} — machine-generated. Judge that it is committed, "
                  f"not its contents. Open it in the worktree if you must.")
        print()

    for n in dotfiles:
        f = wt / n
        if f.exists():
            print(f"--- {n} (inlined; your sandbox will not open dotfiles) ---")
            print(f.read_text())
            print(f"--- end {n} ---\n")

    print("--- how to review ---")
    submitted = pkt.get("submitted_sha")
    if not submitted:
        evidence_line = "the story has no submitted commit yet; ask the planner before reviewing."
    elif evidence_for(pkt, submitted, "light"):
        evidence_line = (f"flo already holds a passing, clean light check for {submitted[:10]}. You may cite it "
                         f"instead of re-running, if your worktree is on that commit and clean.")
    else:
        evidence_line = (f"flo holds no passing light check for {submitted[:10]} yet: run "
                         f"flo check --light on a clean tree at that commit, then cite it.")
    deep = pkt["opus_final"] and not since
    ui = pkt["kind"] == "ui" or "ui" in pkt["tags"]
    ui_step = f"""
   UI story: run the story's Playwright specs once, axe included, and check the keyboard path:
     (cd apps/web && npx playwright test <the spec files this diff adds or changes> --reporter=line 2>&1 | tail -20)
   A failing e2e, an axe violation on a changed route, a control the keyboard cannot reach, a
   hardcoded colour, spacing, radius or duration (tokens only, design-system/MASTER.md), or a
   missing loading, empty or error state is a blocker.""" if ui else ""
    plants = ("a plant only for a guard or test added since your last review, to prove a fix; "
              "do not re-plant anything unchanged" if since else
              "every plant the design packet prescribes, every gate, contract or guard the "
              "diff adds, and at most 2 exploratory plants of your own" if deep else
              "every gate, contract or guard the diff adds, and at most 1 exploratory plant")
    print(f"""\
Budget: this is {'a re-review: confirm each previous finding is fixed and review only the changes above' if since else 'a gated (money/auth/security/migration/concurrency) review' if deep else 'an ungated review'}.
Aim for about {(20 if since else 45 if deep else 40) + (5 if ui else 0)} commands in total. When the steps below are done,
write the verdict and stop; do not widen the review.

1. cd {wt}
   Everything you need is in this packet. Do NOT open AGENTS.md, CLAUDE.md, agents/,
   docs/ or design/ — their review rules are restated here.
   Read the diff above once, then write reviews/{sid}.<your-agent-id>.json at once as a
   draft (verdict, ran_tests false, the defects you suspect) and keep it current as you go:
   the run is stopped at a time cap, and the draft is what survives.
2. Tests, once each, **within your first 10 commands**, and set `ran_tests` true in the draft as
   soon as `flo check --light` has run or you have cited flo's record: a verdict without it does not
   count, and three Codex runs on 21-22 Oct spent their whole call cap reading before testing.
   Evidence: put "evidence": {{"commit": "{submitted}", "profile": "light"}} in the verdict. The
   gate checks it against what flo recorded, and a claim with no matching record does not count.
   {evidence_line} The full suite runs on GitHub
   for {pkt['branch']}; do not run it here.
     apps/api/.venv/bin/python agents/scripts/flo check --light   # lint, types, the story's tests
   Then only the test files a suspicion needs, on the worktree's own database:
     export TEST_DATABASE_URL="$(apps/api/.venv/bin/python agents/scripts/flo db reset)"
     (cd apps/api && .venv/bin/pytest -x -q <one test file> 2>&1 | tail -20)
     (cd apps/web && npx playwright test <one spec> --grep '<test>' --reporter=line 2>&1 | tail -20)
3. Plants: {plants}. A gate you have not seen fail is not reviewed.
   Each plant is ONE command that breaks, tests and restores, so it costs one turn:
     perl -0pi -e 's/<guard>/<broken>/' <file> && (cd apps/api && .venv/bin/pytest -x -q <one test file> 2>&1 | tail -5); git checkout -- <file>
4. Confirm each requirement id above is satisfied by what the diff does, not by what
   it says. Cite the id in any finding it belongs to.
5. Quality and security, on every story, from the diff you already read:
   Quality (the ponytail lens): a helper that duplicates kernel/ or another module's service;
   an abstraction with one use; config for a value that never changes; dead code; a change
   outside the files the packet names; logic without the test AGENTS.md 3.5 requires. Name the
   file and line, and the simpler form that already exists.
   Security: org_id only from the session and every query scoped (a foreign-tenant id must
   return 404); authorization server-side on every path, the ones the UI hides included;
   input validated at the boundary; no injection (raw SQL built from input, unescaped HTML);
   no secret, stack trace or internal detail in a response, log or error (SEC-011); every
   state-changing POST honours Idempotency-Key; money in Decimal, lock before validate, one
   transaction.{ui_step}
6. Finalise the verdict file, then stop. Exactly this shape; verdict is "approve" or
   "changes_requested", severity is "blocker", "major" or "minor", category is
   "correctness", "quality", "security" or "ui":
     {{"story": "{sid}", "reviewer": "<your-agent-id>", "verdict": "approve",
      "ran_tests": true, "evidence": {{"commit": "{submitted}", "profile": "light"}},
      "findings": [{{"severity": "major", "category": "security",
      "file": "path", "line": 1, "requirement": "REQ-001", "problem": "what fails",
      "fix": "what to change"}}]}}

--- tool discipline ---
DO   pipe every test and build command through `| tail -20`; never print a whole log
DO   wait for a long command to finish instead of polling it
DO   read a file once; use `sed -n 'A,Bp'` or `grep -n` for the part you need, and cap
     every read and search with `| head -60`
DO   stop after 2 failed attempts to reproduce a suspicion; report it as `major` or
     `minor` marked "unverified", never as a blocker

--- rules ---
DO   keep every scratch file inside {wt}
DO   use `git checkout -- <file>` to undo a planted violation
DO   write the verdict file even with zero findings
DO   leave the worktree clean apart from your verdict file

DON'T open reviews/ — another reviewer's verdict is not evidence, and agreeing with
      one you have read is not an independent review
DON'T write outside the worktree, /tmp included — the sandbox kills the run
DON'T rewrite the code; review only, the author fixes
DON'T report a defect you have not reproduced in the file as it stands

severity  blocker = wrong, unsafe, or violates a cited requirement (only this blocks merge)
          major   = will break under a foreseeable condition
          minor   = clarity, naming, dead code
You were deliberately not given the author's rationale.""")


# Reviewers are four different models writing JSON by hand, and the schema lives in
# prose in AGENTS.md §2.2 with nothing validating it at write time. "approved" for
# "approve" once read as a rejection and would have blocked a story on a typo. Accept
# the obvious spellings; anything else fails loudly AS MALFORMED rather than quietly
# counting as a rejection.
APPROVE = {"approve", "approved", "lgtm"}
CHANGES_REQUESTED = {"changes_requested", "changes-requested", "request_changes",
                     "changes requested", "reject", "rejected"}


def verdict_of(review):
    """True = approved, False = changes requested, None = unreadable."""
    v = str(review.get("verdict") or "").strip().lower()
    if v in APPROVE:
        return True
    if v in CHANGES_REQUESTED:
        return False
    return None


def reviews_for(sid):
    d = worktree_path(sid) / "reviews"
    if not d.exists():
        return []
    out = []
    for f in sorted(d.glob(f"{sid}.*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except json.JSONDecodeError:
            die(f"malformed review: {f}")
    return out


def evidence_failure(pkt, review):
    """None when the review's evidence block names the submitted commit and flo holds a passing,
    clean record for it; else the reason. The commit is the submitted one, not HEAD: finish.sh
    merges the milestone in before the gate, so HEAD never equals what the reviewer saw."""
    block = review.get("evidence")
    if not isinstance(block, dict) or not block.get("commit"):
        return "it carries no evidence block"
    submitted = pkt.get("submitted_sha")
    if block["commit"] != submitted:
        return f"its evidence is for {str(block['commit'])[:10]}, not the submitted {str(submitted)[:10]}"
    profile = block.get("profile") or "light"
    if not evidence_for(pkt, submitted, profile):
        return f"flo holds no passing clean {profile} check for commit {str(submitted)[:10]}"
    return None


def cmd_gate(argv):
    if not argv:
        die("usage: flo gate <STORY_ID>")
    sid = argv[0]
    began = time.time()
    pkt, wt = packet_of(sid), worktree_path(sid)
    fails = []

    if not checked(wt, "light"):
        fails.append("flo check --light is red (ruff/mypy/import-linter/eslint/tsc/vitest/gitleaks/story tests)")
    if pkt["opus_final"]:
        # Gated stories wait for the full suite on GitHub; everything else merges on the light
        # gate and the milestone CI catches the rest (AGENTS.md §2.4, 13 Oct 2026).
        fail = story_ci_failure(pkt, wt)
        if fail:
            fails.append(fail)

    revs = reviews_for(sid)
    counted = [r for r in revs if r.get("ran_tests") is True]
    if pkt.get("evidence_required"):
        # a claim of "ran tests" counts only with a record flo wrote for the commit that was reviewed
        verified = []
        for r in counted:
            why = evidence_failure(pkt, r)
            if why:
                fails.append(f"{r.get('reviewer', '?')}: ran_tests=true but {why}")
            else:
                verified.append(r)
        counted = verified
    fleet = load_yaml(FLEET)
    need = fleet["policy"]["min_reviewers"]
    if len(counted) < need:
        fails.append(f"{len(counted)}/{need} reviews with ran_tests=true")
    allowed = (set(pkt["reviewers"]) | {s.get("to") for s in pkt.get("substitutions", [])}
               | ({"opus"} if pkt["opus_final"] else set()))
    unexpected = {r["reviewer"] for r in counted} - allowed
    if unexpected:
        fails.append(f"unassigned reviewer(s) {sorted(unexpected)} — record a substitution in task.json")
    if pkt["author"] in {r["reviewer"] for r in counted}:
        fails.append("the author reviewed their own story")
    import flo_facts as F
    blockers = F.open_blockers(revs)
    if blockers:
        fails.append(f"{len(blockers)} open blocker finding(s)")
    unreadable = [r for r in counted if verdict_of(r) is None]
    for r in unreadable:
        fails.append(f"{r.get('reviewer', '?')}: unreadable verdict {r.get('verdict')!r} — "
                     f"expected one of {sorted(APPROVE | CHANGES_REQUESTED)}")
    if any(verdict_of(r) is False for r in counted):
        fails.append("not every counted reviewer approved")

    if pkt["opus_final"]:
        opus = worktree_path(sid) / "reviews" / f"{sid}.opus.json"
        if not opus.exists():
            fails.append(f"story is tagged {pkt['tags']} — Opus final review required (flo final {sid})")
        elif json.loads(opus.read_text()).get("verdict") != "approve":
            fails.append("Opus final review did not approve")

    if not pkt.get("traceability"):
        fails.append("task.json traceability is empty — map each requirement id to the test that covers it")
    recap = (pkt.get("notes") or {}).get("recap")
    if not recap or len(recap.split()) < 6:
        fails.append("task.json notes.recap is missing — write one or two plain sentences "
                     "saying what this story actually delivered, for the board")
    if pkt["notes"].get("blocked"):
        fails.append(f"story is blocked: {pkt['notes']['blocked']}")

    if fails:
        print(f"GATE FAILED — {sid}")
        for f in fails:
            print(f"  ✗ {f}")
        sys.exit(1)
    # re-read: checked() rewrites task.json while the gate runs, so the copy loaded above is stale
    fresh = packet_of(sid)
    fresh["gate_seconds"] = round(time.time() - began)
    (wt / "task.json").write_text(json.dumps(fresh, indent=2) + "\n")
    print(f"GATE PASSED — {sid}")


def cmd_final(argv):
    if not argv:
        die("usage: flo final <STORY_ID>")
    sid = argv[0]
    pkt = packet_of(sid)
    if not pkt["opus_final"]:
        print(f"{sid} is not gated (tags: {pkt['tags'] or 'none'}) — no Opus final review required")
        return
    cmd_review([sid])
    print("\n--- prior reviews ---")
    for r in reviews_for(sid):
        print(json.dumps(r, indent=2))
    print("\n--- Opus: emphasis is SECURITY and UI/UX (agents/claude.md §2) ---")
    print(f"Write: reviews/{sid}.opus.json")


def cmd_escalate(argv):
    if not argv:
        die("usage: flo escalate <STORY_ID>")
    sid = argv[0]
    pkt = packet_of(sid)
    pkt["rounds"] = pkt.get("rounds", 0) + 1  # escalations only; the scorecard's rounds come from round files
    (worktree_path(sid) / "task.json").write_text(json.dumps(pkt, indent=2) + "\n")
    print(f"escalating {sid} to Opus (escalation {pkt['rounds']})")
    cmd_final([sid])
    print("\nOpus: rule on each disputed finding — upheld or dismissed, with reason.")
    print("If the author is wrong three times on the same point, write the fix yourself.")


def cmd_done(argv):
    if not argv:
        die("usage: flo done <STORY_ID>")
    sid = argv[0]
    cmd_gate([sid])
    pkt = packet_of(sid)
    rm = roadmap()
    _, st = find(rm, sid)
    git("checkout", pkt["milestone_branch"])
    git("merge", "--squash", pkt["branch"])
    revs = ", ".join(sorted(r["reviewer"] for r in reviews_for(sid) if r.get("ran_tests")))
    set_status(sid, "done")
    pkt["done_at"] = now_iso()
    record_score(sid, pkt, st)
    # record_score appends this story last, so this is this story's provenance. Reading it
    # before the append took the *previous* story's sessions, and crashed on the first story.
    prov = load_scores()["stories"][-1].get("sessions", {})
    trailers = "".join(
        f"Session-{a}: {s['id']}\n" for a, s in sorted(prov.items()) if s.get("id"))
    msg = (f"{sid}: {st['t']}\n\n"
           f"Requirements: {', '.join(st['reqs'])}\n"
           f"Author: {pkt['author']} | Reviewers: {revs}"
           f"{' | Opus final: approved' if pkt['opus_final'] else ''}\n"
           f"{trailers}")
    cmd_roadmap([])
    cmd_score([])
    git("add", "agents/roadmap.yaml", "docs/claude-plan.md", "agents/project-memory.md",
        "agents/scorecard.json", "agents/SCORECARD.md")
    git("commit", "-m", msg)
    # The worktree outlives the merge: the author's session is keyed to this path, and a red
    # story CI run is fixed by resuming that session here. `flo reap` removes it once CI is green.
    print(f"{sid} merged into {pkt['milestone_branch']}; roadmap and memory updated in the same commit")
    print(f"worktree kept until story CI is green: flo reap {sid}")


def cmd_reap(argv):
    if not argv:
        die("usage: flo reap <STORY_ID> [--force]")
    sid, wt = argv[0], worktree_path(argv[0])
    pkt = packet_of(sid)
    fail = story_ci_failure(pkt, wt)
    if fail and "--force" not in argv:
        die(f"{sid}: {fail} — the worktree stays so its author session can fix it")
    git("worktree", "remove", str(wt), "--force")
    git("push", "origin", "--delete", pkt["branch"], check=False)
    print(f"{sid}: worktree and remote story branch removed")


def set_status(sid, status):
    """Rewrite one story's status in place, whatever YAML style the file uses.

    Anchors on `id: <sid>` then rewrites the first `st:` after it, so this works
    for both flow mappings ({id: X, ..., st: todo}) and block mappings.
    """
    text = ROADMAP.read_text()
    m = re.search(rf"\bid:\s*{re.escape(sid)}\b", text)
    if not m:
        die(f"cannot locate story {sid} in roadmap.yaml")
    tail = re.compile(r"(\bst:\s*)(\w+)").search(text, m.end())
    if not tail:
        die(f"cannot locate status field for {sid} in roadmap.yaml")
    ROADMAP.write_text(text[:tail.start()] + tail.group(1) + status + text[tail.end():])


# ── session provenance ───────────────────────────────────────────────────────
#
# Every story records which concrete CLI session produced and reviewed it, so a
# defect found months later can be traced to the exact transcript. Detection is
# keyed on the story's WORKTREE PATH, so a session is attributed to the story it
# actually worked on rather than to whatever ran most recently.
#
# Nothing here is ever fabricated: if an id cannot be established, it is recorded
# as null with the reason in `source`.

def _claude_session():
    for var in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        if os.environ.get(var):
            return os.environ[var], f"env:{var}"
    return None, "unavailable: not running inside Claude Code"


def _codex_session(cwd):
    root = Path.home() / ".codex" / "sessions"
    if not root.exists():
        return None, "unavailable: ~/.codex/sessions missing"
    best = None
    for f in root.rglob("rollout-*.jsonl"):
        try:
            with f.open() as fh:
                meta = json.loads(fh.readline()).get("payload", {})
        except (OSError, json.JSONDecodeError):
            continue
        if meta.get("cwd") == str(cwd) and meta.get("id"):
            ts = f.stat().st_mtime
            if not best or ts > best[0]:
                best = (ts, meta["id"])
    return (best[1], "codex rollout matched on cwd") if best else \
           (None, f"unavailable: no codex rollout with cwd={cwd}")


def _opencode_session(cwd, model=None):
    """Match on directory AND model - the two OpenCode agents share one store."""
    db = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
    if not db.exists():
        return None, "unavailable: opencode.db missing", {}
    try:
        import sqlite3
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        sql = ("SELECT id, model, cost, tokens_input, tokens_output FROM session "
               "WHERE directory = ?")
        args = [str(cwd)]
        if model:
            sql += " AND model LIKE ?"
            args.append(f"%{model}%")
        row = con.execute(sql + " ORDER BY time_created DESC LIMIT 1", args).fetchone()
    except Exception as e:                                   # noqa: BLE001 - best effort only
        return None, f"unavailable: {type(e).__name__}", {}
    if not row:
        return None, (f"unavailable: no opencode session with directory={cwd}"
                      + (f" and model~{model}" if model else "")), {}
    return row[0], f"opencode.db matched on directory{'+model' if model else ''}", {
        "model": row[1], "cost_usd": row[2],
        "tokens_in": row[3], "tokens_out": row[4],
    }


def detect_session(agent, cwd):
    """Best-effort session provenance. Never invents an id."""
    if os.environ.get("FLO_SESSION_ID"):
        return {"agent": agent, "id": os.environ["FLO_SESSION_ID"], "source": "env:FLO_SESSION_ID"}
    extra = {}
    if agent == "opus":
        sid, src = _claude_session()
    elif agent == "codex":
        sid, src = _codex_session(cwd)
    elif agent.startswith("opencode"):
        cfg = load_yaml(FLEET)["agents"].get(agent, {})
        sid, src, extra = _opencode_session(cwd, cfg.get("model"))
    elif agent == "qwen":
        sid = os.environ.get("FLO_QWEN_GENERATION_ID")
        src = "env:FLO_QWEN_GENERATION_ID" if sid else (
            "unavailable: OpenRouter has no session concept - pass the generation id "
            "to `flo session qwen <id>`")
    else:
        sid, src = None, f"unavailable: no detector for {agent}"
    return {"agent": agent, "id": sid, "source": src, **extra}


def cmd_session(argv):
    if not argv:
        die("usage: flo session <AGENT> [SESSION_ID]   (run from inside the story worktree)")
    agent = argv[0]
    wt = Path.cwd()
    pkt_path = wt / "task.json"
    if not pkt_path.exists():
        die(f"no task.json in {wt} - run this from inside the story worktree")
    pkt = json.loads(pkt_path.read_text())
    rec = ({"agent": agent, "id": argv[1], "source": "supplied"} if len(argv) > 1
           else detect_session(agent, wt))
    pkt.setdefault("sessions", {})[agent] = rec
    pkt_path.write_text(json.dumps(pkt, indent=2) + "\n")
    if rec["id"]:
        print(f"{agent}: {rec['id']}  ({rec['source']})")
    else:
        print(f"{agent}: NOT RECORDED - {rec['source']}", file=sys.stderr)


# ── agent scorecard ──────────────────────────────────────────────────────────

_SCORES_OVERRIDE = None


def load_scores():
    if _SCORES_OVERRIDE is not None:
        return _SCORES_OVERRIDE
    return json.loads(SCORECARD.read_text())


def record_score(sid, pkt, story):
    """Append one immutable record per merged story. Called by `flo done`."""
    revs = reviews_for(sid)
    opus = next((r for r in revs if r["reviewer"] == "opus"), None)
    # A blocker raised by Opus at final review is an escape: two reviewers passed it.
    escapes = [f for f in (opus or {}).get("findings", []) if f.get("severity") == "blocker"]

    sessions = dict(pkt.get("sessions") or {})
    for r in revs:
        who = r["reviewer"]
        if r.get("session_id"):
            sessions[who] = {"agent": who, "id": r["session_id"], "source": "review file"}
        elif who not in sessions:
            sessions[who] = detect_session(who, worktree_path(sid))

    per_reviewer = {}
    for r in revs:
        if r["reviewer"] == "opus":
            continue
        findings = r.get("findings", [])
        # earlier rounds' verdicts, archived by review.sh before each re-review: without them a
        # reviewer that requested changes twice and then approved read as 0 findings (20 Oct)
        earlier = []
        for f in sorted((ROOT / ".scratch" / "reviews").glob(f"{sid}.{r['reviewer']}.r*.json")):
            try:
                earlier.append(json.loads(f.read_text()))
            except json.JSONDecodeError:
                pass  # a half-written archive is skipped, not fatal
        every = findings + [x for e in earlier for x in e.get("findings", [])]
        per_reviewer[r["reviewer"]] = {
            "ran_tests": bool(r.get("ran_tests")),
            "reviews": 1 + len(earlier),
            "findings": len(every),
            "blockers": sum(1 for f in every if f.get("severity") == "blocker"),
            # An escalation records which blockers Opus dismissed as invalid.
            "blockers_dismissed": sum(1 for f in findings
                                      if f.get("severity") == "blocker" and f.get("arbitration") == "dismissed"),
        }

    verdict_mtimes, review_starts = {}, {}
    for r in revs:
        who = r["reviewer"]
        verdict = worktree_path(sid) / "reviews" / f"{sid}.{who}.json"
        marker = ROOT / ".scratch" / f"{sid}.{who}.started"
        if verdict.exists() and marker.exists():
            try:
                review_starts[who] = float(marker.read_text().strip())
                verdict_mtimes[who] = verdict.stat().st_mtime
            except ValueError:
                pass  # a half-written marker is skipped, not fatal
    durations = durations_from(pkt, verdict_mtimes, review_starts,
                               warn=lambda m: print(f"warning: {sid}: {m}", file=sys.stderr))

    # rounds come from the round files, the number the supervisor caps on (flo_facts.rounds_done);
    # a round that sent no itemised finding is void and not charged. task.json "rounds" counts
    # `flo escalate` runs only, and is kept as escalations.
    import flo_facts as F
    scratch = ROOT / ".scratch"
    names = [p.name for p in scratch.iterdir()] if scratch.exists() else []
    texts = [(scratch / n).read_text(errors="replace") for n in names
             if n.startswith(f"{sid}.") and F.ROUND.search(n)]
    done, void = F.rounds_done(names, sid), F.void_rounds(texts)

    sc = load_scores()
    record = {
        "story": sid, "kind": story["k"], "size": story["s"], "tags": story.get("tags", []),
        "author": pkt["author"], "reviewers": sorted(per_reviewer),
        "rounds": max(1, done - void + 1), "void_rounds": void,
        "escalations": pkt.get("rounds", 0), "rounds_basis": "round_files",
        "review_runs": {who: v["reviews"] for who, v in per_reviewer.items()},
        "gate_failures": pkt.get("gate_failures", 0),
        "opus_final": bool(pkt["opus_final"]),
        "escapes": len(escapes),
        "review": per_reviewer,
        "substitutions": pkt.get("substitutions", []),
        "sessions": sessions,
        "recap": (pkt.get("notes") or {}).get("recap", ""),
        "title": story["t"],
    }
    if durations:
        record["durations"] = durations
    sc["stories"] = [s for s in sc["stories"] if s["story"] != sid] + [record]
    SCORECARD.write_text(json.dumps(sc, indent=2) + "\n")


def compute_scores():
    """Author and reviewer scores, 0-100. Returns {agent: metrics}."""
    sc = load_scores()
    rows, floor = sc["stories"], sc.get("min_sample", 3)
    agents = sorted({s["author"] for s in rows} | {r for s in rows for r in s["reviewers"]})
    out = {}
    for a in agents:
        authored = [s for s in rows if s["author"] == a]
        reviewed = [s for s in rows if a in s["reviewers"]]

        m = {"authored": len(authored), "reviewed": len(reviewed)}

        if authored:
            clean = sum(1 for s in authored if s["rounds"] == 1 and s["gate_failures"] == 0)
            rounds = sum(s["rounds"] for s in authored) / len(authored)
            esc = sum(s["escapes"] for s in authored) / len(authored)
            m["verified"] = sum(1 for s in authored if s.get("rounds_basis") == "round_files")
            m["clean_merge_rate"] = clean / len(authored)
            m["mean_rounds"] = rounds
            m["escapes_per_story"] = esc
            m["author_score"] = round(
                50 * m["clean_merge_rate"]
                + 30 * max(0.0, min(1.0, (3 - rounds) / 2))
                + 20 * (1 - min(1.0, esc)), 1) if len(authored) >= floor else None

        if reviewed:
            r = [s["review"][a] for s in reviewed]
            raised = sum(x["blockers"] for x in r)
            dismissed = sum(x["blockers_dismissed"] for x in r)
            missed = sum(s["escapes"] for s in reviewed if s["opus_final"])
            gated = sum(1 for s in reviewed if s["opus_final"]) or 1
            m["test_compliance"] = sum(1 for x in r if x["ran_tests"]) / len(r)
            m["findings_per_review"] = sum(x["findings"] for x in r) / sum(x.get("reviews", 1) for x in r)
            m["blocker_precision"] = (raised - dismissed) / raised if raised else None
            m["escapes_missed"] = missed
            prec = m["blocker_precision"] if m["blocker_precision"] is not None else 0.5
            m["reviewer_score"] = round(
                25 * m["test_compliance"]
                + 30 * prec
                + 30 * (1 - min(1.0, missed / gated))
                + 15 * min(1.0, m["findings_per_review"] / 2), 1) if len(reviewed) >= floor else None

        out[a] = m
    return out, floor


def judgement_progress(records):
    """Verified gated Sonnet records: author sonnet, rounds from round files, any gated tag."""
    return sum(1 for s in records
               if s["author"] == "sonnet" and s.get("rounds_basis") == "round_files"
               and set(s["tags"]) & set(GATED_TAGS))


def render_scores():
    scores, floor = compute_scores()
    sc = load_scores()
    n = len(sc["stories"])
    L = ["<!-- generated by agents/scripts/flo score — do not edit by hand -->", "",
         f"# Agent scorecard", "",
         f"**{n} merged stories.** Scores appear once an agent has {floor}+ samples in that role —",
         "before that the number would be noise, so it reads `—`.", ""]
    if not n:
        L += ["_No stories merged yet._", ""]
        return "\n".join(L)

    legacy = sum(1 for s in sc["stories"] if s.get("rounds_basis") != "round_files")
    if legacy:
        L += [f"> **Data quality.** {legacy} of {n} records took `rounds` from a counter with no reliable",
              "> writer (before E23-S13, 22 Oct 2026): in this repository only `flo escalate` ever raised it, and",
              "> records that also carry review-run counts say 1 round while their reviewers ran up to 7 times.",
              "> *Clean merge*, *Mean rounds* and the author score include those records, so read them as",
              "> indicative until *Rounds verified* equals *Stories*. The records are not rewritten.", ""]
    L += ["## As author", "",
          "| Agent | Stories | Rounds verified | Clean merge | Mean rounds | Escapes/story | Score |",
          "|---|---:|---:|---:|---:|---:|---:|"]
    for a, m in sorted(scores.items(), key=lambda kv: -(kv[1].get("author_score") or -1)):
        if not m["authored"]:
            continue
        s = m.get("author_score")
        L.append(f"| `{a}` | {m['authored']} | {m['verified']}/{m['authored']} | {m['clean_merge_rate']:.0%} | {m['mean_rounds']:.2f} "
                 f"| {m['escapes_per_story']:.2f} | {f'**{s}**' if s is not None else '—'} |")

    have = judgement_progress(sc["stories"])
    L += ["", f"**Judgement day (Sonnet on gated work): {have} of {JUDGEMENT_FLOOR} verified gated records.**"
          + (" It is due: run the script in `docs/ops/sonnet-round-churn.md` and decide." if have >= JUDGEMENT_FLOOR
             else " At " + str(JUDGEMENT_FLOOR) + ", run the script in `docs/ops/sonnet-round-churn.md` and decide.")]
    L += ["", "## As reviewer", "",
          "| Agent | Reviews | Ran tests | Findings/review | Blocker precision | Escapes missed | Score |",
          "|---|---:|---:|---:|---:|---:|---:|"]
    for a, m in sorted(scores.items(), key=lambda kv: -(kv[1].get("reviewer_score") or -1)):
        if not m["reviewed"]:
            continue
        s = m.get("reviewer_score")
        prec = m["blocker_precision"]
        L.append(f"| `{a}` | {m['reviewed']} | {m['test_compliance']:.0%} | {m['findings_per_review']:.1f} "
                 f"| {f'{prec:.0%}' if prec is not None else '—'} | {m['escapes_missed']} "
                 f"| {f'**{s}**' if s is not None else '—'} |")

    L += ["", "## How these are computed", "",
          "**Author score** = 50 × clean-merge rate + 30 × round efficiency + 20 × (1 − escape rate).",
          "A *clean merge* is one review round with no gate failure. *Round efficiency* is full at one",
          "round and zero at three. An *escape* is a blocker Opus found at final review — meaning two",
          "reviewers approved code that was wrong. A *round* is one review that sent itemised findings back",
          "to the author, counted from the round files the supervisor caps on, plus one for the first",
          "submission; a round file with no itemised finding is a `void_round` and is not charged.", "",
          "**Reviewer score** = 25 × test compliance + 30 × blocker precision + 30 × catch rate",
          "+ 15 × thoroughness. *Precision* is blockers upheld ÷ blockers raised, so crying wolf costs.",
          "*Catch rate* penalises escapes on stories this agent approved. *Thoroughness* saturates at two",
          "findings per review — more than that is not better.", "",
          "> Use these to route work, not to rank agents. A low author score on `money` stories and a high",
          "> one on `crud` is a routing signal, not a verdict. Adjust `allowed_kinds` in `agents/agents.yaml`.", ""]
    return "\n".join(L)


def render_durations(sc):
    """Median stage durations by kind, author and reviewer, in minutes. stdout only: the committed
    SCORECARD.md and the immutable records are untouched. A cell under min_sample prints a dash."""
    recs, floor = sc["stories"], sc.get("min_sample", 3)
    have = [s for s in recs if s.get("durations")]

    def cell(values, fn=statistics.median):
        return f"{fn(values) / 60:.1f}" if len(values) >= floor else "—"

    def pick(group, key):
        return [s["durations"][key] for s in group if key in s["durations"]]

    lines = []
    for title, key in (("kind", "kind"), ("author", "author")):
        lines += [f"By {title}", f"{title:<20} {'n':>3} {'wall':>7} {'author':>7} {'gate':>7} {'max wall':>9}"]
        for name in sorted({s[key] for s in have}):
            grp = [s for s in have if s[key] == name]
            lines.append(f"{name:<20} {len(grp):>3} {cell(pick(grp, 'wall_s')):>7} "
                         f"{cell(pick(grp, 'author_s')):>7} {cell(pick(grp, 'gate_s')):>7} "
                         f"{cell(pick(grp, 'wall_s'), max):>9}")
        lines.append("")
    per = {}
    for s in have:
        for who, secs in s["durations"].get("review_s", {}).items():
            per.setdefault(who, []).append(secs)
    lines += ["By reviewer (last round, launch to verdict)", f"{'reviewer':<20} {'n':>3} {'median':>7}"]
    for who in sorted(per):
        lines.append(f"{who:<20} {len(per[who]):>3} {cell(per[who]):>7}")
    lines += ["", "minutes; a dash means fewer than %d records" % floor,
              f"{len(have)} of {len(recs)} records carry durations"]
    return "\n".join(lines)


def cmd_score(argv):
    if "--durations" in argv:
        print(render_durations(load_scores()))
        return
    body = render_scores()
    if "--check" in argv:
        if SCORE_MD.exists() and SCORE_MD.read_text() == body + "\n":
            print("scorecard in sync")
            return
        die("agents/SCORECARD.md is stale — run: agents/scripts/flo score")
    SCORE_MD.write_text(body + "\n")
    scores, _ = compute_scores()
    n = len(load_scores()["stories"])
    print(f"scorecard regenerated ({n} merged stories, {len(scores)} agents)")
    if n:
        print(render_scores().split("## How these")[0].split("## As author")[1].rstrip())


# ── reporting ────────────────────────────────────────────────────────────────

def render_roadmap(rm):
    done = {s["id"] for _, s in stories(rm) if s["st"] == "done"}
    icon = {"done": "✅", "in_progress": "🔨", "review": "👀", "design": "📐",
            "blocked": "⛔", "todo": "⬜"}
    lines = ["<!-- generated by agents/scripts/flo roadmap — do not edit by hand -->", ""]
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        total = sum(len(e["stories"]) for e in eps)
        closed = sum(1 for e in eps for s in e["stories"] if s["st"] == "done")
        lines += [f"#### {m['id']} — {m['name']} · {closed}/{total} done", "",
                  f"> {m['goal']}", "",
                  "| | Story | Epic | Kind | Size | Requirements | Depends on |",
                  "|---|---|---|---|---|---|---|"]
        for e in eps:
            for s in e["stories"]:
                dep = ", ".join(f"~~{d}~~" if d in done else d for d in s.get("dep", [])) or "—"
                lines.append(f"| {icon.get(s['st'], '⬜')} | **{s['id']}** {s['t']} | {e['id']} "
                             f"| {s['k']} | {s['s']} | {', '.join(s['reqs'])} | {dep} |")
        lines.append("")
    return "\n".join(lines)


def cmd_roadmap(argv):
    rm = roadmap()
    body = render_roadmap(rm)
    text = PLAN.read_text()
    begin, end = "<!-- ROADMAP:BEGIN -->", "<!-- ROADMAP:END -->"
    if begin not in text or end not in text:
        die("ROADMAP markers missing from docs/claude-plan.md")
    new = re.sub(re.escape(begin) + r".*?" + re.escape(end),
                 f"{begin}\n{body}\n{end}", text, flags=re.S)
    if "--check" in argv:
        if new != text:
            die("docs/claude-plan.md §5 is stale — run: agents/scripts/flo roadmap")
        print("roadmap in sync")
        return
    PLAN.write_text(new)
    update_memory(rm)
    print(f"regenerated docs/claude-plan.md §5 ({sum(1 for _, s in stories(rm) if s['st'] == 'done')}"
          f"/{sum(1 for _ in stories(rm))} done)")


def update_memory(rm):
    all_s = [s for _, s in stories(rm)]
    done = [s for s in all_s if s["st"] == "done"]
    flight = [s for s in all_s if s["st"] in ACTIVE and s["st"] != "blocked"]
    blocked = [s for s in all_s if s["st"] == "blocked"]
    cur = next((m for m in rm["milestones"]
                if any(s["st"] != "done" for e in rm["epics"] if e["milestone"] == m["id"]
                       for s in e["stories"])), rm["milestones"][-1])
    block = "\n".join([
        "## Current state", "",
        "| | |", "|---|---|",
        f"| Milestone | **{cur['id']} — {cur['name']}** |",
        f"| Stories | {len(done)} / {len(all_s)} done |",
        f"| Branch | {cur['branch']} |",
        f"| In flight | {', '.join(s['id'] for s in flight) or '—'} |",
        f"| Blocked | {', '.join(s['id'] for s in blocked) or '—'} |",
    ])
    text = MEMORY.read_text()
    MEMORY.write_text(re.sub(r"<!-- STATE:BEGIN -->.*?<!-- STATE:END -->",
                             f"<!-- STATE:BEGIN -->\n{block}\n<!-- STATE:END -->",
                             text, flags=re.S))


def cmd_status(argv):
    rm = roadmap()
    all_s = [s for _, s in stories(rm)]
    print(f"XLR8 FLO — {sum(1 for s in all_s if s['st'] == 'done')}/{len(all_s)} stories done\n")
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ss = [s for e in eps for s in e["stories"]]
        d = sum(1 for s in ss if s["st"] == "done")
        bar = "█" * round(20 * d / len(ss)) + "·" * (20 - round(20 * d / len(ss)))
        print(f"  {m['id']}  {bar}  {d:>3}/{len(ss)}  {m['name']}")
    live = [s for s in all_s if s["st"] in ACTIVE]
    if live:
        print("\nin flight:")
        for s in live:
            print(f"  {s['id']}  [{s['st']:<12}] {s['t']}")


def cmd_budget(argv):
    fleet, sp = load_yaml(FLEET), state().get("spend", {})
    print(f"{'agent':<20}{'plan':<20}{'metered':<9}remaining")
    for n, c in fleet["agents"].items():
        if c.get("monthly_budget_usd"):
            rem = f"${c['monthly_budget_usd'] - sp.get(n, 0.0):.2f} / ${c['monthly_budget_usd']}"
        elif c.get("weekly_story_budget"):
            rem = f"{c['weekly_story_budget'] - sp.get(n, 0)} stories this week"
        elif c.get("metered") == "rate":
            rem = "rate-limited — batch design, gate final review"
        else:
            rem = "unmetered"
        print(f"{n:<20}{c['plan']:<20}{c.get('metered', 'none'):<9}{rem}")


