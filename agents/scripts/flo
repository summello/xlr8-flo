def _pill(stt):
    cls, label = {"todo": ("todo", "Todo"), "design": ("dsg", "Awaiting design"),
                  "in_progress": ("prog", "In progress"), "review": ("rev", "In review"),
                  "blocked": ("blk", "Blocked"), "done": ("done", "Done")}.get(stt, ("todo", stt))
    return f'<span class="pill {cls}"><i></i>{label}</span>'


def _esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def _burnup(rm, recaps):
    """Cumulative completion per milestone — where we are, at a glance."""
    ms = rm["milestones"]
    W, H, pad = 720, 150, 26
    totals, dones, x = [], [], []
    run_t = run_d = 0
    for m in ms:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ss = [s for e in eps for s in e["stories"]]
        run_t += len(ss); run_d += sum(1 for s in ss if s["st"] == "done")
        totals.append(run_t); dones.append(run_d)
    top = totals[-1] or 1
    step = (W - pad * 2) / max(1, len(ms) - 1)
    def pt(i, v): return (pad + i * step, H - pad - (v / top) * (H - pad * 2))
    plan = " ".join(f"{a:.0f},{b:.0f}" for a, b in (pt(i, v) for i, v in enumerate(totals)))
    act = " ".join(f"{a:.0f},{b:.0f}" for a, b in (pt(i, v) for i, v in enumerate(dones)))
    labels = "".join(
        f'<text x="{pt(i,0)[0]:.0f}" y="{H-8}" font-size="10" fill="var(--fg3)" '
        f'text-anchor="middle">{m["id"]}</text>' for i, m in enumerate(ms))
    dots = "".join(f'<circle cx="{a:.0f}" cy="{b:.0f}" r="3" fill="var(--ok)"/>'
                   for a, b in (pt(i, v) for i, v in enumerate(dones)))
    return f'''<svg viewBox="0 0 {W} {H}" role="img" aria-label="Cumulative stories planned versus delivered by milestone">
  <polyline points="{plan}" fill="none" stroke="var(--bs)" stroke-width="1.5" stroke-dasharray="5 4"/>
  <polyline points="{act}" fill="none" stroke="var(--ok)" stroke-width="2"/>
  {dots}{labels}
  <text x="{pad}" y="16" font-size="10" fill="var(--fg3)">0 → {top} stories · dashed = scope, solid = delivered</text>
</svg>'''


def pending_on_human(rm, fleet):
    """Only the things a person must resolve. Not agent work.

    Each item carries a stable `key` and a `sig`. Acknowledging an item stores its
    signature; if the underlying fact changes the ack goes stale and the item
    returns. Acknowledging is not resolving, and the board says so.
    """
    items = []
    for epic, s in stories(rm):
        if s["st"] == "blocked":
            q = None
            wt = worktree_path(s["id"]) / "task.json"
            if wt.exists():
                q = (json.loads(wt.read_text()).get("notes") or {}).get("blocked")
            items.append(dict(key=f"blocked:{s['id']}", sig=s["st"],
                              kind="Decision needed", ref=s["id"], name=s["t"],
                              why=q or "Story is blocked; the question is in its task packet."))
        # operator prerequisites: things only a person with an account can provide
        pre = s.get("prereq") or []
        if pre and s["st"] != "done":
            items.append(dict(key=f"prereq:{s['id']}", sig=str(len(pre)),
                              kind="Operator prerequisite", ref=s["id"], name=s["t"],
                              why="Cannot be verified end to end until you provide: "
                                  + "; ".join(pre)))
    # a milestone fully done but not yet merged to main
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ss = [s for e in eps for s in e["stories"]]
        if ss and all(s["st"] == "done" for s in ss):
            merged = git("branch", "--merged", "main", check=False)
            if m["branch"] not in merged:
                items.append(dict(key=f"pr:{m['id']}", sig=str(len(ss)),
                                  kind="Open the milestone PR", ref=m["id"], name=m["name"],
                                  why=f"Every story in {m['id']} is merged into {m['branch']}. "
                                      f"It needs a pull request to main."))
    # design packets missing for the milestone in progress
    cur = next((m for m in rm["milestones"]
                if any(s["st"] != "done" for e in rm["epics"] if e["milestone"] == m["id"]
                       for s in e["stories"])), None)
    if cur:
        eps = [e for e in rm["epics"] if e["milestone"] == cur["id"]]
        missing = [s["id"] for e in eps for s in e["stories"]
                   if s["st"] == "todo" and not (ROOT / "design" / f"{s['id']}.md").exists()]
        if missing:
            items.append(dict(key=f"design:{cur['id']}", sig=str(len(missing)),
                              kind="Run the design pass", ref=cur["id"], name=cur["name"],
                              why=f"{len(missing)} stories have no design packet. "
                                  f"Opus must run `flo design {cur['id']}` before any can start."))
    # spend
    sp = state().get("spend", {})
    for name, cfg in fleet["agents"].items():
        cap = cfg.get("monthly_budget_usd")
        if cap and sp.get(name, 0) >= cap * 0.8:
            items.append(dict(key=f"budget:{name}", sig=f"{sp.get(name,0):.0f}",
                              kind="Budget nearly spent", ref=name, name=cfg["plan"],
                              why=f"${sp.get(name,0):.2f} of ${cap} used. Raise the cap in "
                                  f"agents.yaml or {name} drops out of the review rotation."))
    return items


def split_acked(items):
    """Partition into (open, confirmed). An ack whose signature moved is dropped."""
    acks = state().get("acks", {})
    open_, done = [], []
    for it in items:
        a = acks.get(it["key"])
        (done if a and a.get("sig") == it["sig"] else open_).append({**it, "ack": a})
    return open_, done


def cmd_ack(argv):
    """flo ack <KEY|all> — acknowledge a pending item. Acknowledging is not resolving."""
    if not argv:
        items = pending_on_human(roadmap(), load_yaml(FLEET))
        if not items:
            print("nothing pending")
            return
        print("usage: flo ack <KEY>   (or `flo ack all`)\n")
        for it in items:
            print(f"  {it['key']:22} {it['kind']} · {it['ref']}")
        return
    rm, fleet = roadmap(), load_yaml(FLEET)
    items = {i["key"]: i for i in pending_on_human(rm, fleet)}
    keys = list(items) if argv[0] == "all" else [argv[0]]
    unknown = [k for k in keys if k not in items]
    if unknown:
        die(f"unknown pending key(s): {', '.join(unknown)} — run `flo ack` to list them")
    s = state()
    acks = s.setdefault("acks", {})
    stamp = git("log", "-1", "--format=%cI", check=False) or "unknown"
    for k in keys:
        acks[k] = {"sig": items[k]["sig"], "at": stamp}
        print(f"confirmed  {k}  ({items[k]['kind']} · {items[k]['ref']})")
    save_state(s)
    print("\nAcknowledged, not resolved — these return if the underlying fact changes.")
    cmd_board([])


def cmd_unack(argv):
    if not argv:
        die("usage: flo unack <KEY|all>")
    s = state()
    acks = s.setdefault("acks", {})
    for k in (list(acks) if argv[0] == "all" else [argv[0]]):
        acks.pop(k, None)
        print(f"reopened  {k}")
    save_state(s)
    cmd_board([])


def cmd_board(argv):
    rm, fleet = roadmap(), load_yaml(FLEET)
    sc = {s["story"]: s for s in load_scores()["stories"]}
    all_s = [s for _, s in stories(rm)]
    done = [s for s in all_s if s["st"] == "done"]
    active = [s for s in all_s if s["st"] in ACTIVE]
    ready = [(e, s) for e, s in stories(rm) if s["st"] == "todo" and deps_satisfied(rm, s)]
    pending, confirmed = split_acked(pending_on_human(rm, fleet))
    pct = len(done) / len(all_s) * 100 if all_s else 0

    parts = [f"<title>XLR8 FLO Board</title>", f"<style>{BOARD_CSS}</style>",
             '<link rel="preconnect" href="https://fonts.googleapis.com">',
             # Explicit +, not implicit adjacency: CodeQL reads adjacent string
             # literals inside a list as a possible missing comma, and that warning
             # fails the code-scanning gate on every pull request.
             ('<link rel="stylesheet" href="https://fonts.googleapis.com/css2?'
              + 'family=Inter:wght@400;500;560;600;620;640'
              + '&family=JetBrains+Mono:wght@400;460;620&display=swap">'),
             '<div class="w">', "<header>",
             f'<div><p class="eb">Delivery board</p><h1>XLR8 FLO</h1></div><div class="sp"></div>',
             f'<div class="stat"><span class="eb">Delivered</span><b>{len(done)}/{len(all_s)}</b></div>',
             f'<div class="stat"><span class="eb">Complete</span><b>{pct:.0f}%</b></div>',
             f'<div class="stat"><span class="eb">In flight</span><b>{len(active)}</b></div>',
             f'<div class="stat"><span class="eb">Ready to start</span><b>{len(ready)}</b></div>',
             f'<div class="stat"><span class="eb">On you</span><b>{len(pending)}</b></div>',
             "</header>"]

    parts += ['<section><h2>Progress</h2><div class="card chart">', _burnup(rm, sc), "</div></section>"]

    # ── pending on the human ──
    parts.append('<section><h2>Waiting on you</h2><div class="card you">')
    if pending:
        for it in pending:
            parts.append(f'<div class="row"><div class="q"><b>{_esc(it["kind"])} · '
                         f'<span class="mono">{_esc(it["ref"])}</span> {_esc(it["name"])}</b>'
                         f'<span>{_esc(it["why"])}</span>'
                         f'<span class="mono" style="font-size:10.5px;opacity:.7">'
                         f'flo ack {_esc(it["key"])}</span></div></div>')
    else:
        parts.append('<div class="empty">Nothing open. The fleet is unblocked.</div>')
    parts.append("</div>")
    if confirmed:
        parts.append('<div class="card ok" style="margin-top:12px">')
        for it in confirmed:
            when = (it.get("ack") or {}).get("at", "")[:10]
            parts.append(f'<div class="row"><b>✓ {_esc(it["kind"])} · '
                         f'<span class="mono">{_esc(it["ref"])}</span></b>'
                         f'<span>{_esc(it["why"])}</span>'
                         f'<span class="when">confirmed {_esc(when)}</span></div>')
        parts.append('<p class="hint">Confirmed, not resolved — each returns automatically if its '
                     'underlying fact changes. Reopen with <span class="mono">flo unack &lt;key&gt;</span>.</p>')
        parts.append("</div>")
    parts.append("</section>")

    # ── next up ──
    parts.append('<section><h2>Next up</h2><div class="card next">')
    if ready:
        for e, s in ready[:6]:
            parts.append(f'<div class="row">{_pill(s["st"])}<span class="mono" style="font-size:11.5px;'
                         f'color:var(--fg3)">{s["id"]}</span><span>{_esc(s["t"])}</span>'
                         f'<span class="cmd">flo start {s["id"]}</span></div>')
    else:
        parts.append('<div class="empty">No story has its dependencies satisfied.</div>')
    parts.append("</div></section>")

    # ── agent scores ──
    scores, floor = compute_scores()
    parts.append('<section><h2>Agent performance</h2><div class="two">')

    def _grade(v):
        return "gn" if v is None else ("g80" if v >= 75 else "g60" if v >= 55 else "g0")

    def _cell(v):
        cls = _grade(v)
        if v is None:
            return '<span class="scv gn">—</span>'
        hue = "var(--ok)" if v >= 75 else "var(--info)" if v >= 55 else "var(--warn)"
        return (f'<span class="spark"><i style="width:{v:.0f}%;background:{hue}"></i></span>'
                f'<span class="scv {cls}">{v:.0f}</span>')

    auth = [(a, m) for a, m in scores.items() if m.get("authored")]
    rev = [(a, m) for a, m in scores.items() if m.get("reviewed")]

    parts.append('<div class="card"><table class="sc"><tr><th>As author</th>'
                 '<th class="r">Stories</th><th class="r">Clean</th><th class="r">Rounds</th>'
                 '<th class="r">Score</th></tr>')
    if auth:
        for a, m in sorted(auth, key=lambda kv: -(kv[1].get("author_score") or -1)):
            parts.append(f'<tr><td class="ag">{_esc(a)}</td><td class="r">{m["authored"]}</td>'
                         f'<td class="r">{m["clean_merge_rate"]:.0%}</td>'
                         f'<td class="r">{m["mean_rounds"]:.2f}</td>'
                         f'<td class="r">{_cell(m.get("author_score"))}</td></tr>')
    else:
        parts.append('<tr><td colspan="5" class="empty">No stories merged yet.</td></tr>')
    parts.append(f'</table><p class="hint">Score = 50 × clean-merge + 30 × round efficiency '
                 f'+ 20 × (1 − escape rate). Shown once an agent has {floor}+ stories.</p></div>')

    parts.append('<div class="card"><table class="sc"><tr><th>As reviewer</th>'
                 '<th class="r">Reviews</th><th class="r">Tests</th><th class="r">Missed</th>'
                 '<th class="r">Score</th></tr>')
    if rev:
        for a, m in sorted(rev, key=lambda kv: -(kv[1].get("reviewer_score") or -1)):
            parts.append(f'<tr><td class="ag">{_esc(a)}</td><td class="r">{m["reviewed"]}</td>'
                         f'<td class="r">{m["test_compliance"]:.0%}</td>'
                         f'<td class="r">{m["escapes_missed"]}</td>'
                         f'<td class="r">{_cell(m.get("reviewer_score"))}</td></tr>')
    else:
        parts.append('<tr><td colspan="5" class="empty">No reviews recorded yet.</td></tr>')
    parts.append(f'</table><p class="hint">Score = 25 × test compliance + 30 × blocker precision '
                 f'+ 30 × catch rate + 15 × thoroughness. <em>Missed</em> counts escapes on gated '
                 f'stories this agent approved.</p></div>')
    parts.append('</div><p class="hint" style="padding-left:0">These route work; they do not rank '
                 'agents. A low author score on one <span class="mono">kind</span> and a high one on '
                 'another is a signal to change <span class="mono">allowed_kinds</span> in '
                 '<span class="mono">agents/agents.yaml</span>.</p></section>')

    # ── drilldown ──
    parts.append("<section><h2>Milestones</h2>")
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ms_s = [s for e in eps for s in e["stories"]]
        d = sum(1 for s in ms_s if s["st"] == "done")
        w = (d / len(ms_s) * 100) if ms_s else 0
        opn = "open" if any(s["st"] != "done" for s in ms_s) and d < len(ms_s) else ""
        parts.append(
            f'<details class="card ms" {opn}><summary>'
            f'<span class="caret">▸</span><span class="nm">{m["id"]} · {_esc(m["name"])}</span>'
            f'<span class="sp"></span><span class="track"><span class="fill" style="width:{w:.0f}%"></span></span>'
            f'<span class="cnt">{d}/{len(ms_s)}</span></summary>')
        for e in eps:
            ed = sum(1 for s in e["stories"] if s["st"] == "done")
            ew = ed / len(e["stories"]) * 100
            parts.append(
                f'<details class="epic"><summary><span class="caret">▸</span>'
                f'<span class="mono" style="font-size:11.5px;color:var(--fg3)">{e["id"]}</span>'
                f'<span>{_esc(e["name"])}</span><span class="sp"></span>'
                f'<span class="track" style="width:88px"><span class="fill" style="width:{ew:.0f}%"></span></span>'
                f'<span class="cnt">{ed}/{len(e["stories"])}</span></summary><table>')
            for s in e["stories"]:
                rec = sc.get(s["id"], {})
                recap = rec.get("recap")
                sess = rec.get("sessions") or {}
                who = rec.get("author", "")
                meta = (f'{_esc(who)}<br>{rec["rounds"]} round'
                        f'{"s" if rec.get("rounds",1) != 1 else ""}') if rec else \
                       "".join(f'<span class="tag">{t}</span>' for t in s.get("tags", []))
                body = _esc(s["t"])
                if recap:
                    body += f'<span class="recap">{_esc(recap)}</span>'
                if sess:
                    ids = " · ".join(f'{a}:{v["id"][:8]}' for a, v in sorted(sess.items()) if v.get("id"))
                    if ids:
                        body += f'<span class="recap mono" style="font-size:10.5px;opacity:.75">{_esc(ids)}</span>'
                parts.append(f'<tr><td class="id">{s["id"]}</td><td class="st">{_pill(s["st"])}</td>'
                             f'<td>{body}</td><td class="meta">{meta}</td></tr>')
            parts.append("</table></details>")
        parts.append("</details>")
    parts.append("</section>")

    parts.append(f'<footer>Generated by <span class="mono">flo board</span> from '
                 f'<span class="mono">agents/roadmap.yaml</span> and '
                 f'<span class="mono">agents/scorecard.json</span>. '
                 f'Gitignored — regenerate any time, never commit.</footer></div>')
    BOARD.write_text("\n".join(parts) + "\n")
    print(f"board.html regenerated — {len(done)}/{len(all_s)} delivered, {len(ready)} ready, "
          f"{len(pending)} waiting on you"
          + (f", {len(confirmed)} confirmed" if confirmed else ""))


# ── shells ───────────────────────────────────────────────────────────────────

CHECKS = [
    ("ruff", ["ruff", "check", "apps/api"]),
    ("mypy", ["mypy", "--strict", "apps/api/src/flo"]),
    ("boundaries", ["lint-imports"]),
    # Same flags CI runs. Without them a green `flo check` can still fail CI on a
    # missing pytest-cov, which is exactly how E01-S01 reached a red pull request.
    ("pytest", ["pytest", "-q", "apps/api", "--cov=flo", "--cov-report=term-missing"]),
    ("eslint", ["npm", "--prefix", "apps/web", "run", "lint"]),
    ("tsc", ["npm", "--prefix", "apps/web", "run", "typecheck"]),
    ("vitest", ["npm", "--prefix", "apps/web", "run", "test"]),
    ("e2e+axe", ["npm", "--prefix", "apps/web", "run", "test:e2e"]),
    ("secrets", ["gitleaks", "detect", "--no-banner"]),
]

# Every current M0 check is delivered and therefore mandatory. Temporary exemptions must
# name both their reason and the story that removes them; docs/ops/ci-gates.md mirrors this.
M0_MISSING_TOOL_OPTOUTS = {}
LOCAL_TEST_DATABASE_URL = "postgresql://flo:flo-local@127.0.0.1:5432/flo_test"


def run_check(cwd=None):
    cwd = cwd or ROOT
    ok = True
    for name, cmd in CHECKS:
        command_environment = os.environ.copy()
        if name == "pytest":
            command_environment.setdefault("DATABASE_URL", LOCAL_TEST_DATABASE_URL)
        try:
            r = subprocess.run(
                cmd,
                cwd=cwd,
                capture_output=True,
                text=True,
                env=command_environment,
            )
        except FileNotFoundError:
            r = subprocess.CompletedProcess(cmd, 127, "", f"required tool not found: {cmd[0]}")
        if r.returncode == 127:
            exemption = M0_MISSING_TOOL_OPTOUTS.get(name)
            if exemption is not None:
                print(f"  ?  {name:<12} missing-tool opt-out: {exemption}")
                continue
        print(f"  {'✓' if not r.returncode else '✗'}  {name}")
        if r.returncode:
            print((r.stdout + r.stderr).strip()[-2000:])
            ok = False
    return ok


def cmd_check(argv):
    sys.exit(0 if run_check(Path.cwd()) else 1)


COMPOSE = ROOT / "compose.yaml"
STACK_SERVICES = ("postgres", "minio", "mailpit")


def _run_compose(*args, capture_output=False):
    if not COMPOSE.exists():
        die("compose.yaml missing — story E01-S02 delivers it")
    cmd = ["podman", "compose", "-f", str(COMPOSE), *args]
    try:
        return subprocess.run(cmd, check=True, capture_output=capture_output, text=True)
    except FileNotFoundError:
        die("podman is required for the local stack but was not found on PATH")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "no error output").strip()
        die(f"{' '.join(cmd)} failed: {detail}")


def _container_status(service, include_stopped=False):
    ps_args = ["ps"]
    if include_stopped:
        ps_args.append("--all")
    ps_args.extend(["--quiet", service])
    result = _run_compose(*ps_args, capture_output=True)
    container_ids = result.stdout.splitlines()
    if not container_ids:
        return None, None, None
    inspect = subprocess.run(
        [
            "podman",
            "inspect",
            "--format",
            "{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.ExitCode}}",
            container_ids[0],
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if inspect.returncode:
        return None, None, None
    status, health, exit_code = inspect.stdout.strip().split("|", maxsplit=2)
    return status, health or None, int(exit_code)


def _wait_for_stack(timeout_seconds=120):
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        services = {service: _container_status(service) for service in STACK_SERVICES}
        for service, (status, health, _) in services.items():
            if health == "unhealthy" or status in {"dead", "exited"}:
                die(f"{service} failed while the local stack was starting ({health or status})")

        init_status, _, init_exit_code = _container_status("minio-init", include_stopped=True)
        init_ready = init_status == "exited" and init_exit_code == 0
        if init_status == "exited" and init_exit_code != 0:
            die(f"minio-init failed with exit code {init_exit_code}")
        if all(health == "healthy" for _, health, _ in services.values()) and init_ready:
            return
        time.sleep(1)
    die(f"local stack did not become healthy within {timeout_seconds} seconds")


def cmd_up(argv):
    if argv not in ([], ["--reset"]):
        die("usage: flo up [--reset]")
    if argv == ["--reset"]:
        _run_compose("down", "--volumes", "--remove-orphans")
    _run_compose("up", "-d")
    _wait_for_stack()
    print("Postgres:     postgresql://localhost:5432/flo_dev")
    print("MinIO API:   http://localhost:9000")
    print("MinIO console: http://localhost:9001")
    print("Mailpit UI:  http://localhost:8025")


def cmd_down(argv):
    if argv:
        die("usage: flo down")
    _run_compose("down")


def cmd_design(argv):
    if not argv:
        die("usage: flo design <MILESTONE_ID>")
    mid = argv[0]
    rm = roadmap()
    eps = [e for e in rm["epics"] if e["milestone"] == mid]
    if not eps:
        die(f"unknown milestone {mid}")
    ss = [(e, s) for e in eps for s in e["stories"]]
    print(f"OPUS BATCH DESIGN — {mid} ({len(ss)} stories)\n")
    print("Write design/<STORY_ID>.md for each story below, in this order, in ONE pass.")
    print("Format: agents/plan.md §3. Inline the requirement text — coding agents must not")
    print("need to open docs/requirements.md. If a packet needs an undecided business rule,")
    print("mark the story blocked and surface the question. Never guess at money, state")
    print("transitions, or authorization.\n")
    for e, s in ss:
        print(f"  {s['id']}  [{s['k']}/{s['s']}] {s['t']}")
        print(f"           requirements: {', '.join(s['reqs'])}")
        if s.get("dep"):
            print(f"           after: {', '.join(s['dep'])}")


COMMANDS = {
    "next": cmd_next, "start": cmd_start, "assign": cmd_assign, "submit": cmd_submit,
    "review": cmd_review, "gate": cmd_gate, "final": cmd_final, "escalate": cmd_escalate,
    "done": cmd_done, "design": cmd_design, "status": cmd_status, "budget": cmd_budget,
    "roadmap": cmd_roadmap, "score": cmd_score, "session": cmd_session, "board": cmd_board,
    "ack": cmd_ack, "unack": cmd_unack, "check": cmd_check, "up": cmd_up, "down": cmd_down,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)
    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r}\n{__doc__}")
    COMMANDS[cmd](sys.argv[2:])
