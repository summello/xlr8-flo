#!/usr/bin/env python3
"""flo — XLR8 FLO delivery orchestrator.

Every rule in AGENTS.md that can be machine-checked lives here instead of in prose.
Stdlib only, except PyYAML for the two config files.

  flo next                  next story whose dependencies are satisfied
  flo start   <STORY_ID>    branch + worktree + task packet
  flo assign  <STORY_ID>    compute author and two reviewers from agents.yaml
  flo submit  <STORY_ID>    mark ready for review, print reviewer commands
  flo review  <STORY_ID>    print the reviewer packet (diff + design + requirements)
  flo gate    <STORY_ID>    Definition of Done, machine-checked
  flo final   <STORY_ID>    Opus final-review packet (gated stories)
  flo escalate<STORY_ID>    hand the story to Opus for arbitration
  flo done    <STORY_ID>    squash-merge into the milestone branch, update roadmap
  flo design  <MILESTONE>   print the Opus batch-design brief for a milestone
  flo status                roadmap state and in-flight stories
  flo score   [--check]     agent performance scorecard (author + reviewer)
  flo session <AGENT> [ID]  record an agent's session id for the current story
  flo budget                per-agent spend and remaining capacity
  flo roadmap [--check]     regenerate docs/claude-plan.md §5 (or verify it)
  flo board                 regenerate board.html - drilldown status view (gitignored)\n  flo ack     [KEY|all]     confirm a 'waiting on you' item (list keys with no argument)\n  flo unack   <KEY|all>     reopen a confirmed item
  flo check                 run everything CI runs, locally
  flo up [--reset]          start local Postgres + MinIO + Mailpit; optionally reset data
  flo down                  stop the local stack
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
ROADMAP = ROOT / "agents" / "roadmap.yaml"
FLEET = ROOT / "agents" / "agents.yaml"
PLAN = ROOT / "docs" / "claude-plan.md"
MEMORY = ROOT / "agents" / "project-memory.md"
STATE = ROOT / "agents" / ".state.json"
SCORECARD = ROOT / "agents" / "scorecard.json"
SCORE_MD = ROOT / "agents" / "SCORECARD.md"
BOARD = ROOT / "board.html"
TERMINAL = {"done"}
ACTIVE = {"design", "in_progress", "review", "blocked"}


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def load_yaml(path):
    try:
        import yaml
    except ImportError:
        die("PyYAML required: pip install pyyaml")
    with open(path) as fh:
        return yaml.safe_load(fh)


def roadmap():
    return load_yaml(ROADMAP)


def stories(rm):
    for epic in rm["epics"]:
        for st in epic["stories"]:
            yield epic, st


def find(rm, sid):
    for epic, st in stories(rm):
        if st["id"] == sid:
            return epic, st
    die(f"unknown story {sid}")


def state():
    return json.loads(STATE.read_text()) if STATE.exists() else {"stories": {}, "spend": {}}


def save_state(s):
    STATE.write_text(json.dumps(s, indent=2, sort_keys=True) + "\n")


def git(*args, cwd=None, check=True):
    r = subprocess.run(["git", *args], cwd=cwd or ROOT, capture_output=True, text=True)
    if check and r.returncode:
        die(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:48]


def worktree_path(sid):
    return ROOT.parent / f"{ROOT.name}-{sid}"


def milestone_of(rm, epic):
    for m in rm["milestones"]:
        if m["id"] == epic["milestone"]:
            return m
    die(f"unknown milestone {epic['milestone']}")


# ── planning ─────────────────────────────────────────────────────────────────

def deps_satisfied(rm, st):
    done = {s["id"] for _, s in stories(rm) if s["st"] == "done"}
    return all(d in done for d in st.get("dep", []))


def cmd_next(argv):
    rm, fleet = roadmap(), load_yaml(FLEET)
    cap = fleet["policy"]["max_stories_in_flight"]
    in_flight = [s for _, s in stories(rm) if s["st"] in ACTIVE]
    if len(in_flight) >= cap:
        print(f"{len(in_flight)}/{cap} stories in flight — finish one before starting another:")
        for s in in_flight:
            print(f"  {s['id']}  [{s['st']}]  {s['t']}")
        return
    ready = [(e, s) for e, s in stories(rm) if s["st"] == "todo" and deps_satisfied(rm, s)]
    if not ready:
        blocked = [s for _, s in stories(rm) if s["st"] == "todo"]
        die("no story is ready" + (f" ({len(blocked)} todo, all dependency-blocked)" if blocked else " — roadmap complete"))
    epic, st = ready[0]
    print(f"{st['id']}  {st['t']}")
    print(f"  epic {epic['id']} {epic['name']} · milestone {epic['milestone']} · {st['k']}/{st['s']}")
    print(f"  requirements: {', '.join(st['reqs'])}")
    print(f"\n  flo start {st['id']}")


def cmd_assign(argv):
    """Implements the algorithm documented at the foot of agents/agents.yaml."""
    if not argv:
        die("usage: flo assign <STORY_ID>")
    rm, fleet = roadmap(), load_yaml(FLEET)
    epic, st = find(rm, argv[0])
    pol, agents, sp = fleet["policy"], fleet["agents"], state().get("spend", {})
    tags = set(st.get("tags", []))

    # Step 0 — a milestone override wins outright over the capacity heuristic.
    ov = (fleet.get("milestone_overrides") or {}).get(epic["milestone"])
    if ov:
        author = ov["sole_author"]
        if st["k"] not in agents[author].get("allowed_kinds", []):
            die(f"{argv[0]}: milestone override makes {author} sole author but kind="
                f"{st['k']} is not in its allowed_kinds — widen it in agents.yaml")
        reviewers = [r for r in ov["reviewers"] if r != author]
        if len(reviewers) < pol["min_reviewers"]:
            die(f"override for {epic['milestone']} leaves {len(reviewers)} reviewer(s); "
                f"minimum is {pol['min_reviewers']}")
        out = {"author": author, "reviewers": reviewers,
               "opus_final": bool(ov.get("opus_final_all")) or bool(tags & set(pol["opus_final_required_tags"])),
               "override": epic["milestone"]}
        print(json.dumps(out, indent=2))
        return out

    size_rank = {"S": 1, "M": 2, "L": 3}
    scarcity = {"none": 0, "spend": 1, "rate": 2}

    def can_author(name, cfg):
        if "author" not in cfg.get("roles", []):
            return False
        if st["k"] not in cfg.get("allowed_kinds", []):
            return False
        cap = cfg.get("max_author_size")
        if cap and size_rank[st["s"]] > size_rank[cap]:
            return False
        if cfg.get("monthly_budget_usd"):
            spent = sp.get(name, 0.0)
            usable = cfg["monthly_budget_usd"] - cfg.get("reserve_for_review_usd", 0)
            if spent >= usable:
                return False
        return True

    cands = [n for n, c in agents.items() if can_author(n, c)]
    if not cands:
        die(f"no agent may author kind={st['k']} size={st['s']} — check allowed_kinds in agents.yaml")

    def rank(n):
        c = agents[n]
        prefers = bool(tags & set(c.get("prefer_tags", [])))
        return (0 if prefers else 1, scarcity[c.get("metered", "none")])

    author = sorted(cands, key=rank)[0]
    # At least one reviewer must be unmetered, so a rationed agent is never the
    # reason a story cannot merge. Cheapest reviewers first for the second slot.
    pool = [n for n in pol["free_reviewer_pool"] if n != author and "review" in agents[n]["roles"]]
    if not pool:
        die(f"no free reviewer available for author {author} — widen policy.free_reviewer_pool")
    reviewers = [pool[0]]
    rest = sorted((n for n, c in agents.items()
                   if n != author and n not in reviewers and "review" in c.get("roles", [])),
                  key=lambda n: scarcity[agents[n].get("metered", "none")])
    reviewers += rest[: pol["min_reviewers"] - len(reviewers)]
    if len(reviewers) < pol["min_reviewers"]:
        die(f"only {len(reviewers)} reviewer(s) available; minimum is {pol['min_reviewers']} — story waits")
    opus_final = bool(tags & set(pol["opus_final_required_tags"]))
    out = {"author": author, "reviewers": reviewers, "opus_final": opus_final}
    print(json.dumps(out, indent=2))
    return out


# ── story lifecycle ──────────────────────────────────────────────────────────

def cmd_start(argv):
    if not argv:
        die("usage: flo start <STORY_ID>")
    sid = argv[0]
    rm = roadmap()
    epic, st = find(rm, sid)
    if st["st"] != "todo":
        die(f"{sid} is {st['st']}, not todo")
    if not deps_satisfied(rm, st):
        pending = [d for d in st.get("dep", []) if find(rm, d)[1]["st"] != "done"]
        die(f"{sid} depends on unfinished: {', '.join(pending)}")
    design = ROOT / "design" / f"{sid}.md"
    if not design.exists():
        die(f"no design packet at design/{sid}.md — run: flo design {epic['milestone']}")

    ms = milestone_of(rm, epic)
    branches = git("branch", "--list", ms["branch"])
    if not branches:
        git("branch", ms["branch"])
    branch = f"story/{sid}-{slug(st['t'])}"
    wt = worktree_path(sid)
    if wt.exists():
        die(f"worktree already exists: {wt}")
    git("worktree", "add", "-b", branch, str(wt), ms["branch"])

    assignment = cmd_assign([sid])
    packet = {
        "story": sid, "title": st["t"], "epic": epic["id"], "milestone": epic["milestone"],
        "kind": st["k"], "size": st["s"], "tags": st.get("tags", []),
        "requirements": st["reqs"], "depends_on": st.get("dep", []),
        "branch": branch, "milestone_branch": ms["branch"], "worktree": str(wt),
        "design": f"design/{sid}.md", **assignment,
        "rounds": 0, "substitutions": [], "notes": {"blocked": None, "followup": [], "recap": None},
        "traceability": {},
    }
    packet["sessions"] = {assignment["author"]: detect_session(assignment["author"], wt)}
    (wt / "task.json").write_text(json.dumps(packet, indent=2) + "\n")
    set_status(sid, "in_progress")
    print(f"\nworktree  {wt}\nbranch    {branch}\ndesign    design/{sid}.md")
    print(f"author    {assignment['author']}\nreviewers {', '.join(assignment['reviewers'])}"
          f"\nopus final{'  required' if assignment['opus_final'] else '  not required'}")
    if assignment.get("override"):
        print(f"override  {assignment['override']} — sole author by milestone policy "
              f"(agents/agents.yaml milestone_overrides)")
    print(f"\n  cd {wt} && cat design/{sid}.md")


def packet_of(sid):
    p = worktree_path(sid) / "task.json"
    if not p.exists():
        die(f"no task packet for {sid} — run: flo start {sid}")
    return json.loads(p.read_text())


def cmd_submit(argv):
    if not argv:
        die("usage: flo submit <STORY_ID>")
    sid = argv[0]
    pkt = packet_of(sid)
    if not run_check(worktree_path(sid)):
        die("flo check is red — fix before submitting; two of four agents are rate-limited")
    rec = detect_session(pkt["author"], worktree_path(sid))
    if rec["id"]:
        pkt.setdefault("sessions", {})[pkt["author"]] = rec
        (worktree_path(sid) / "task.json").write_text(json.dumps(pkt, indent=2) + "\n")
    set_status(sid, "review")
    print(f"{sid} ready for review. Reviewers must run:\n")
    for r in pkt["reviewers"]:
        print(f"  {r}:  flo review {sid}   → reviews/{sid}.{r}.json")


def cmd_review(argv):
    if not argv:
        die("usage: flo review <STORY_ID>")
    sid = argv[0]
    pkt, wt = packet_of(sid), worktree_path(sid)
    print(f"=== REVIEW PACKET {sid} — {pkt['title']} ===")
    print(f"kind {pkt['kind']} · size {pkt['size']} · tags {', '.join(pkt['tags']) or 'none'}")
    print(f"requirements: {', '.join(pkt['requirements'])}\n")
    print("--- design packet ---")
    print((ROOT / pkt["design"]).read_text())
    print("--- diff vs milestone branch ---")
    print(git("diff", f"{pkt['milestone_branch']}...{pkt['branch']}", cwd=wt, check=False))
    print("\n--- rules ---")
    print("Run the tests: a verdict with ran_tests=false does not count toward the two-reviewer floor.")
    print("Review only — do not rewrite the code. One finding per problem.")
    print("You were deliberately not given the author's rationale.")
    print(f"\nWrite: reviews/{sid}.<your-agent-id>.json   (schema in AGENTS.md §2.2)")


def reviews_for(sid):
    d = worktree_path(sid) / "reviews"
    if not d.exists():
        return []
    out = []
    for f in sorted(d.glob(f"{sid}.*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except json.JSONDecodeError:
            die(f"malformed review: {f}")
    return out


def cmd_gate(argv):
    if not argv:
        die("usage: flo gate <STORY_ID>")
    sid = argv[0]
    pkt, wt = packet_of(sid), worktree_path(sid)
    fails = []

    if not run_check(wt):
        fails.append("flo check is red (ruff/mypy/import-linter/eslint/tsc/pytest/vitest/playwright/axe/gitleaks)")

    revs = reviews_for(sid)
    counted = [r for r in revs if r.get("ran_tests") is True]
    fleet = load_yaml(FLEET)
    need = fleet["policy"]["min_reviewers"]
    if len(counted) < need:
        fails.append(f"{len(counted)}/{need} reviews with ran_tests=true")
    allowed = set(pkt["reviewers"]) | {s.get("to") for s in pkt.get("substitutions", [])}
    unexpected = {r["reviewer"] for r in counted} - allowed
    if unexpected:
        fails.append(f"unassigned reviewer(s) {sorted(unexpected)} — record a substitution in task.json")
    if pkt["author"] in {r["reviewer"] for r in counted}:
        fails.append("the author reviewed their own story")
    blockers = [f for r in revs for f in r.get("findings", []) if f.get("severity") == "blocker"]
    if blockers:
        fails.append(f"{len(blockers)} open blocker finding(s)")
    if any(r.get("verdict") != "approve" for r in counted):
        fails.append("not every counted reviewer approved")

    if pkt["opus_final"]:
        opus = worktree_path(sid) / "reviews" / f"{sid}.opus.json"
        if not opus.exists():
            fails.append(f"story is tagged {pkt['tags']} — Opus final review required (flo final {sid})")
        elif json.loads(opus.read_text()).get("verdict") != "approve":
            fails.append("Opus final review did not approve")

    if not pkt.get("traceability"):
        fails.append("task.json traceability is empty — map each requirement id to the test that covers it")
    recap = (pkt.get("notes") or {}).get("recap")
    if not recap or len(recap.split()) < 6:
        fails.append("task.json notes.recap is missing — write one or two plain sentences "
                     "saying what this story actually delivered, for the board")
    if pkt["notes"].get("blocked"):
        fails.append(f"story is blocked: {pkt['notes']['blocked']}")

    if fails:
        print(f"GATE FAILED — {sid}")
        for f in fails:
            print(f"  ✗ {f}")
        sys.exit(1)
    print(f"GATE PASSED — {sid}")


def cmd_final(argv):
    if not argv:
        die("usage: flo final <STORY_ID>")
    sid = argv[0]
    pkt = packet_of(sid)
    if not pkt["opus_final"]:
        print(f"{sid} is not gated (tags: {pkt['tags'] or 'none'}) — no Opus final review required")
        return
    cmd_review([sid])
    print("\n--- prior reviews ---")
    for r in reviews_for(sid):
        print(json.dumps(r, indent=2))
    print("\n--- Opus: emphasis is SECURITY and UI/UX (agents/claude.md §2) ---")
    print(f"Write: reviews/{sid}.opus.json")


def cmd_escalate(argv):
    if not argv:
        die("usage: flo escalate <STORY_ID>")
    sid = argv[0]
    pkt = packet_of(sid)
    pkt["rounds"] = pkt.get("rounds", 0) + 1
    (worktree_path(sid) / "task.json").write_text(json.dumps(pkt, indent=2) + "\n")
    print(f"escalating {sid} to Opus (round {pkt['rounds']})")
    cmd_final([sid])
    print("\nOpus: rule on each disputed finding — upheld or dismissed, with reason.")
    print("If the author is wrong three times on the same point, write the fix yourself.")


def cmd_done(argv):
    if not argv:
        die("usage: flo done <STORY_ID>")
    sid = argv[0]
    cmd_gate([sid])
    pkt = packet_of(sid)
    rm = roadmap()
    _, st = find(rm, sid)
    git("checkout", pkt["milestone_branch"])
    git("merge", "--squash", pkt["branch"])
    revs = ", ".join(sorted(r["reviewer"] for r in reviews_for(sid) if r.get("ran_tests")))
    set_status(sid, "done")
    record_score(sid, pkt, st)
    # record_score appends this story last, so this is this story's provenance. Reading it
    # before the append took the *previous* story's sessions, and crashed on the first story.
    prov = load_scores()["stories"][-1].get("sessions", {})
    trailers = "".join(
        f"Session-{a}: {s['id']}\n" for a, s in sorted(prov.items()) if s.get("id"))
    msg = (f"{sid}: {st['t']}\n\n"
           f"Requirements: {', '.join(st['reqs'])}\n"
           f"Author: {pkt['author']} | Reviewers: {revs}"
           f"{' | Opus final: approved' if pkt['opus_final'] else ''}\n"
           f"{trailers}")
    cmd_roadmap([])
    cmd_score([])
    cmd_board([])
    git("add", "agents/roadmap.yaml", "docs/claude-plan.md", "agents/project-memory.md",
        "agents/scorecard.json", "agents/SCORECARD.md")
    git("commit", "-m", msg)
    git("worktree", "remove", str(worktree_path(sid)), "--force")
    print(f"{sid} merged into {pkt['milestone_branch']}; roadmap and memory updated in the same commit")


def set_status(sid, status):
    """Rewrite one story's status in place, whatever YAML style the file uses.

    Anchors on `id: <sid>` then rewrites the first `st:` after it, so this works
    for both flow mappings ({id: X, ..., st: todo}) and block mappings.
    """
    text = ROADMAP.read_text()
    m = re.search(rf"\bid:\s*{re.escape(sid)}\b", text)
    if not m:
        die(f"cannot locate story {sid} in roadmap.yaml")
    tail = re.compile(r"(\bst:\s*)(\w+)").search(text, m.end())
    if not tail:
        die(f"cannot locate status field for {sid} in roadmap.yaml")
    ROADMAP.write_text(text[:tail.start()] + tail.group(1) + status + text[tail.end():])


# ── session provenance ───────────────────────────────────────────────────────
#
# Every story records which concrete CLI session produced and reviewed it, so a
# defect found months later can be traced to the exact transcript. Detection is
# keyed on the story's WORKTREE PATH, so a session is attributed to the story it
# actually worked on rather than to whatever ran most recently.
#
# Nothing here is ever fabricated: if an id cannot be established, it is recorded
# as null with the reason in `source`.

def _claude_session():
    for var in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        if os.environ.get(var):
            return os.environ[var], f"env:{var}"
    return None, "unavailable: not running inside Claude Code"


def _codex_session(cwd):
    root = Path.home() / ".codex" / "sessions"
    if not root.exists():
        return None, "unavailable: ~/.codex/sessions missing"
    best = None
    for f in root.rglob("rollout-*.jsonl"):
        try:
            with f.open() as fh:
                meta = json.loads(fh.readline()).get("payload", {})
        except (OSError, json.JSONDecodeError):
            continue
        if meta.get("cwd") == str(cwd) and meta.get("id"):
            ts = f.stat().st_mtime
            if not best or ts > best[0]:
                best = (ts, meta["id"])
    return (best[1], "codex rollout matched on cwd") if best else \
           (None, f"unavailable: no codex rollout with cwd={cwd}")


def _opencode_session(cwd, model=None):
    """Match on directory AND model - the two OpenCode agents share one store."""
    db = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
    if not db.exists():
        return None, "unavailable: opencode.db missing", {}
    try:
        import sqlite3
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        sql = ("SELECT id, model, cost, tokens_input, tokens_output FROM session "
               "WHERE directory = ?")
        args = [str(cwd)]
        if model:
            sql += " AND model LIKE ?"
            args.append(f"%{model}%")
        row = con.execute(sql + " ORDER BY time_created DESC LIMIT 1", args).fetchone()
    except Exception as e:                                   # noqa: BLE001 - best effort only
        return None, f"unavailable: {type(e).__name__}", {}
    if not row:
        return None, (f"unavailable: no opencode session with directory={cwd}"
                      + (f" and model~{model}" if model else "")), {}
    return row[0], f"opencode.db matched on directory{'+model' if model else ''}", {
        "model": row[1], "cost_usd": row[2],
        "tokens_in": row[3], "tokens_out": row[4],
    }


def detect_session(agent, cwd):
    """Best-effort session provenance. Never invents an id."""
    if os.environ.get("FLO_SESSION_ID"):
        return {"agent": agent, "id": os.environ["FLO_SESSION_ID"], "source": "env:FLO_SESSION_ID"}
    extra = {}
    if agent == "opus":
        sid, src = _claude_session()
    elif agent == "codex":
        sid, src = _codex_session(cwd)
    elif agent.startswith("opencode"):
        cfg = load_yaml(FLEET)["agents"].get(agent, {})
        sid, src, extra = _opencode_session(cwd, cfg.get("model"))
    elif agent == "qwen":
        sid = os.environ.get("FLO_QWEN_GENERATION_ID")
        src = "env:FLO_QWEN_GENERATION_ID" if sid else (
            "unavailable: OpenRouter has no session concept - pass the generation id "
            "to `flo session qwen <id>`")
    else:
        sid, src = None, f"unavailable: no detector for {agent}"
    return {"agent": agent, "id": sid, "source": src, **extra}


def cmd_session(argv):
    if not argv:
        die("usage: flo session <AGENT> [SESSION_ID]   (run from inside the story worktree)")
    agent = argv[0]
    wt = Path.cwd()
    pkt_path = wt / "task.json"
    if not pkt_path.exists():
        die(f"no task.json in {wt} - run this from inside the story worktree")
    pkt = json.loads(pkt_path.read_text())
    rec = ({"agent": agent, "id": argv[1], "source": "supplied"} if len(argv) > 1
           else detect_session(agent, wt))
    pkt.setdefault("sessions", {})[agent] = rec
    pkt_path.write_text(json.dumps(pkt, indent=2) + "\n")
    if rec["id"]:
        print(f"{agent}: {rec['id']}  ({rec['source']})")
    else:
        print(f"{agent}: NOT RECORDED - {rec['source']}", file=sys.stderr)


# ── agent scorecard ──────────────────────────────────────────────────────────

def load_scores():
    return json.loads(SCORECARD.read_text())


def record_score(sid, pkt, story):
    """Append one immutable record per merged story. Called by `flo done`."""
    revs = reviews_for(sid)
    opus = next((r for r in revs if r["reviewer"] == "opus"), None)
    # A blocker raised by Opus at final review is an escape: two reviewers passed it.
    escapes = [f for f in (opus or {}).get("findings", []) if f.get("severity") == "blocker"]

    sessions = dict(pkt.get("sessions") or {})
    for r in revs:
        who = r["reviewer"]
        if r.get("session_id"):
            sessions[who] = {"agent": who, "id": r["session_id"], "source": "review file"}
        elif who not in sessions:
            sessions[who] = detect_session(who, worktree_path(sid))

    per_reviewer = {}
    for r in revs:
        if r["reviewer"] == "opus":
            continue
        findings = r.get("findings", [])
        per_reviewer[r["reviewer"]] = {
            "ran_tests": bool(r.get("ran_tests")),
            "findings": len(findings),
            "blockers": sum(1 for f in findings if f.get("severity") == "blocker"),
            # An escalation records which blockers Opus dismissed as invalid.
            "blockers_dismissed": sum(1 for f in findings
                                      if f.get("severity") == "blocker" and f.get("arbitration") == "dismissed"),
        }

    sc = load_scores()
    sc["stories"] = [s for s in sc["stories"] if s["story"] != sid] + [{
        "story": sid, "kind": story["k"], "size": story["s"], "tags": story.get("tags", []),
        "author": pkt["author"], "reviewers": sorted(per_reviewer),
        "rounds": pkt.get("rounds", 0) + 1,
        "gate_failures": pkt.get("gate_failures", 0),
        "opus_final": bool(pkt["opus_final"]),
        "escapes": len(escapes),
        "review": per_reviewer,
        "substitutions": pkt.get("substitutions", []),
        "sessions": sessions,
        "recap": (pkt.get("notes") or {}).get("recap", ""),
        "title": story["t"],
    }]
    SCORECARD.write_text(json.dumps(sc, indent=2) + "\n")


def compute_scores():
    """Author and reviewer scores, 0-100. Returns {agent: metrics}."""
    sc = load_scores()
    rows, floor = sc["stories"], sc.get("min_sample", 3)
    agents = sorted({s["author"] for s in rows} | {r for s in rows for r in s["reviewers"]})
    out = {}
    for a in agents:
        authored = [s for s in rows if s["author"] == a]
        reviewed = [s for s in rows if a in s["reviewers"]]

        m = {"authored": len(authored), "reviewed": len(reviewed)}

        if authored:
            clean = sum(1 for s in authored if s["rounds"] == 1 and s["gate_failures"] == 0)
            rounds = sum(s["rounds"] for s in authored) / len(authored)
            esc = sum(s["escapes"] for s in authored) / len(authored)
            m["clean_merge_rate"] = clean / len(authored)
            m["mean_rounds"] = rounds
            m["escapes_per_story"] = esc
            m["author_score"] = round(
                50 * m["clean_merge_rate"]
                + 30 * max(0.0, min(1.0, (3 - rounds) / 2))
                + 20 * (1 - min(1.0, esc)), 1) if len(authored) >= floor else None

        if reviewed:
            r = [s["review"][a] for s in reviewed]
            raised = sum(x["blockers"] for x in r)
            dismissed = sum(x["blockers_dismissed"] for x in r)
            missed = sum(s["escapes"] for s in reviewed if s["opus_final"])
            gated = sum(1 for s in reviewed if s["opus_final"]) or 1
            m["test_compliance"] = sum(1 for x in r if x["ran_tests"]) / len(r)
            m["findings_per_review"] = sum(x["findings"] for x in r) / len(r)
            m["blocker_precision"] = (raised - dismissed) / raised if raised else None
            m["escapes_missed"] = missed
            prec = m["blocker_precision"] if m["blocker_precision"] is not None else 0.5
            m["reviewer_score"] = round(
                25 * m["test_compliance"]
                + 30 * prec
                + 30 * (1 - min(1.0, missed / gated))
                + 15 * min(1.0, m["findings_per_review"] / 2), 1) if len(reviewed) >= floor else None

        out[a] = m
    return out, floor


def render_scores():
    scores, floor = compute_scores()
    sc = load_scores()
    n = len(sc["stories"])
    L = ["<!-- generated by agents/scripts/flo score — do not edit by hand -->", "",
         f"# Agent scorecard", "",
         f"**{n} merged stories.** Scores appear once an agent has {floor}+ samples in that role —",
         "before that the number would be noise, so it reads `—`.", ""]
    if not n:
        L += ["_No stories merged yet._", ""]
        return "\n".join(L)

    L += ["## As author", "",
          "| Agent | Stories | Clean merge | Mean rounds | Escapes/story | Score |",
          "|---|---:|---:|---:|---:|---:|"]
    for a, m in sorted(scores.items(), key=lambda kv: -(kv[1].get("author_score") or -1)):
        if not m["authored"]:
            continue
        s = m.get("author_score")
        L.append(f"| `{a}` | {m['authored']} | {m['clean_merge_rate']:.0%} | {m['mean_rounds']:.2f} "
                 f"| {m['escapes_per_story']:.2f} | {f'**{s}**' if s is not None else '—'} |")

    L += ["", "## As reviewer", "",
          "| Agent | Reviews | Ran tests | Findings/review | Blocker precision | Escapes missed | Score |",
          "|---|---:|---:|---:|---:|---:|---:|"]
    for a, m in sorted(scores.items(), key=lambda kv: -(kv[1].get("reviewer_score") or -1)):
        if not m["reviewed"]:
            continue
        s = m.get("reviewer_score")
        prec = m["blocker_precision"]
        L.append(f"| `{a}` | {m['reviewed']} | {m['test_compliance']:.0%} | {m['findings_per_review']:.1f} "
                 f"| {f'{prec:.0%}' if prec is not None else '—'} | {m['escapes_missed']} "
                 f"| {f'**{s}**' if s is not None else '—'} |")

    L += ["", "## How these are computed", "",
          "**Author score** = 50 × clean-merge rate + 30 × round efficiency + 20 × (1 − escape rate).",
          "A *clean merge* is one review round with no gate failure. *Round efficiency* is full at one",
          "round and zero at three. An *escape* is a blocker Opus found at final review — meaning two",
          "reviewers approved code that was wrong.", "",
          "**Reviewer score** = 25 × test compliance + 30 × blocker precision + 30 × catch rate",
          "+ 15 × thoroughness. *Precision* is blockers upheld ÷ blockers raised, so crying wolf costs.",
          "*Catch rate* penalises escapes on stories this agent approved. *Thoroughness* saturates at two",
          "findings per review — more than that is not better.", "",
          "> Use these to route work, not to rank agents. A low author score on `money` stories and a high",
          "> one on `crud` is a routing signal, not a verdict. Adjust `allowed_kinds` in `agents/agents.yaml`.", ""]
    return "\n".join(L)


def cmd_score(argv):
    body = render_scores()
    if "--check" in argv:
        if SCORE_MD.exists() and SCORE_MD.read_text() == body + "\n":
            print("scorecard in sync")
            return
        die("agents/SCORECARD.md is stale — run: agents/scripts/flo score")
    SCORE_MD.write_text(body + "\n")
    scores, _ = compute_scores()
    n = len(load_scores()["stories"])
    print(f"scorecard regenerated ({n} merged stories, {len(scores)} agents)")
    if n:
        print(render_scores().split("## How these")[0].split("## As author")[1].rstrip())


# ── reporting ────────────────────────────────────────────────────────────────

def render_roadmap(rm):
    done = {s["id"] for _, s in stories(rm) if s["st"] == "done"}
    icon = {"done": "✅", "in_progress": "🔨", "review": "👀", "design": "📐",
            "blocked": "⛔", "todo": "⬜"}
    lines = ["<!-- generated by agents/scripts/flo roadmap — do not edit by hand -->", ""]
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        total = sum(len(e["stories"]) for e in eps)
        closed = sum(1 for e in eps for s in e["stories"] if s["st"] == "done")
        lines += [f"#### {m['id']} — {m['name']} · {closed}/{total} done", "",
                  f"> {m['goal']}", "",
                  "| | Story | Epic | Kind | Size | Requirements | Depends on |",
                  "|---|---|---|---|---|---|---|"]
        for e in eps:
            for s in e["stories"]:
                dep = ", ".join(f"~~{d}~~" if d in done else d for d in s.get("dep", [])) or "—"
                lines.append(f"| {icon.get(s['st'], '⬜')} | **{s['id']}** {s['t']} | {e['id']} "
                             f"| {s['k']} | {s['s']} | {', '.join(s['reqs'])} | {dep} |")
        lines.append("")
    return "\n".join(lines)


def cmd_roadmap(argv):
    rm = roadmap()
    body = render_roadmap(rm)
    text = PLAN.read_text()
    begin, end = "<!-- ROADMAP:BEGIN -->", "<!-- ROADMAP:END -->"
    if begin not in text or end not in text:
        die("ROADMAP markers missing from docs/claude-plan.md")
    new = re.sub(re.escape(begin) + r".*?" + re.escape(end),
                 f"{begin}\n{body}\n{end}", text, flags=re.S)
    if "--check" in argv:
        if new != text:
            die("docs/claude-plan.md §5 is stale — run: agents/scripts/flo roadmap")
        print("roadmap in sync")
        return
    PLAN.write_text(new)
    update_memory(rm)
    print(f"regenerated docs/claude-plan.md §5 ({sum(1 for _, s in stories(rm) if s['st'] == 'done')}"
          f"/{sum(1 for _ in stories(rm))} done)")


def update_memory(rm):
    all_s = [s for _, s in stories(rm)]
    done = [s for s in all_s if s["st"] == "done"]
    flight = [s for s in all_s if s["st"] in ACTIVE and s["st"] != "blocked"]
    blocked = [s for s in all_s if s["st"] == "blocked"]
    cur = next((m for m in rm["milestones"]
                if any(s["st"] != "done" for e in rm["epics"] if e["milestone"] == m["id"]
                       for s in e["stories"])), rm["milestones"][-1])
    block = "\n".join([
        "## Current state", "",
        "| | |", "|---|---|",
        f"| Milestone | **{cur['id']} — {cur['name']}** |",
        f"| Stories | {len(done)} / {len(all_s)} done |",
        f"| Branch | {cur['branch']} |",
        f"| In flight | {', '.join(s['id'] for s in flight) or '—'} |",
        f"| Blocked | {', '.join(s['id'] for s in blocked) or '—'} |",
    ])
    text = MEMORY.read_text()
    MEMORY.write_text(re.sub(r"<!-- STATE:BEGIN -->.*?<!-- STATE:END -->",
                             f"<!-- STATE:BEGIN -->\n{block}\n<!-- STATE:END -->",
                             text, flags=re.S))


def cmd_status(argv):
    rm = roadmap()
    all_s = [s for _, s in stories(rm)]
    print(f"XLR8 FLO — {sum(1 for s in all_s if s['st'] == 'done')}/{len(all_s)} stories done\n")
    for m in rm["milestones"]:
        eps = [e for e in rm["epics"] if e["milestone"] == m["id"]]
        ss = [s for e in eps for s in e["stories"]]
        d = sum(1 for s in ss if s["st"] == "done")
        bar = "█" * round(20 * d / len(ss)) + "·" * (20 - round(20 * d / len(ss)))
        print(f"  {m['id']}  {bar}  {d:>3}/{len(ss)}  {m['name']}")
    live = [s for s in all_s if s["st"] in ACTIVE]
    if live:
        print("\nin flight:")
        for s in live:
            print(f"  {s['id']}  [{s['st']:<12}] {s['t']}")


def cmd_budget(argv):
    fleet, sp = load_yaml(FLEET), state().get("spend", {})
    print(f"{'agent':<20}{'plan':<20}{'metered':<9}remaining")
    for n, c in fleet["agents"].items():
        if c.get("monthly_budget_usd"):
            rem = f"${c['monthly_budget_usd'] - sp.get(n, 0.0):.2f} / ${c['monthly_budget_usd']}"
        elif c.get("weekly_story_budget"):
            rem = f"{c['weekly_story_budget'] - sp.get(n, 0)} stories this week"
        elif c.get("metered") == "rate":
            rem = "rate-limited — batch design, gate final review"
        else:
            rem = "unmetered"
        print(f"{n:<20}{c['plan']:<20}{c.get('metered', 'none'):<9}{rem}")


