[importlinter]
root_package = flo
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    flo.api
    flo.modules
    flo.kernel

[importlinter:contract:module-independence]
name = Business modules are independent
type = independence
modules =
    flo.modules.*
# AGENTS.md 3.3: a module may import another module's service and schemas, never its models,
# repo or db. Every other cross-module edge (including the package root) stays forbidden.
unmatched_ignore_imports_alerting = none
ignore_imports =
    flo.modules.** -> flo.modules.*.service
    flo.modules.** -> flo.modules.*.schemas

[importlinter:contract:local-identity-adapter]
name = Local identity adapter is hidden behind the port
type = forbidden
source_modules =
    flo.api
    flo.modules
    flo.kernel.*
forbidden_modules =
    flo.kernel.identity.local
ignore_imports =
    flo.kernel.identity -> flo.kernel.identity.local

[importlinter:contract:module-external-effects]
name = Business modules use kernel ports for external effects
type = forbidden
allow_indirect_imports = True
source_modules =
    flo.modules
forbidden_modules =
    boto3
    botocore
    httpx
    requests
    urllib
