# ── Local / generated. Safe to ignore: nothing reads these from a worktree. ──

# Review verdicts — per-story, ephemeral, consumed by `flo gate` in place.
reviews/*.json

# Story task packet — written by `flo start` into the worktree, read by gate/done in
# place. Committing it squash-merges ephemeral state into ROOT, and every later
# `flo start` then rewrites a tracked file.
task.json

# Delivery board — regenerated by `flo board` on every merge. Local view, never committed.
board.html

# Orchestrator local state (agent spend counters).
agents/.state.json

# Superseded planning documents. docs/claude-plan.md replaced both.
docs/codex-plan.md
docs/nemotron-plan.md

# ── Secrets and environment ──
.env
.env.*
!.env.example
*.pem
*.key
gha-creds-*.json

# ── Build output and dependencies ──
node_modules/
dist/
build/
.vite/
apps/web/src/api/generated/*.timestamp
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage/
playwright-report/
test-results/

# ── OS / editor ──
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
