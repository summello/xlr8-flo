# ── Local / generated. Safe to ignore: nothing reads these from a worktree. ──

# Design packets — flo resolves these from the repo root, never from the worktree,
# so agents still get them via `flo review` / `flo start`.
design/*.md
!design/README.md

# Review verdicts — per-story, ephemeral, consumed by `flo gate` in place.
reviews/*.json

# Delivery board — regenerated by `flo board` on every merge. Local view, never committed.
board.html

# Orchestrator local state (agent spend counters).
agents/.state.json

# Superseded planning documents. docs/claude-plan.md replaced both.
docs/codex-plan.md
docs/nemotron-plan.md

# ── Secrets and environment ──
.env
.env.*
!.env.example
*.pem
*.key
gha-creds-*.json

# ── Build output and dependencies ──
node_modules/
dist/
build/
.vite/
apps/web/src/api/generated/*.timestamp
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage/
playwright-report/
test-results/

